---
import View from '../../views/Post.astro';
import { postsIn, slugOf, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  return (await postsIn('en')).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---
<View post={post} />

---
// Stand-in for pages built in later phases, so every nav link resolves in both languages.
import Base from '../layouts/Base.astro';
import { getLang, useT, href } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';

interface Props { titleKey: UIKey; num: string; }
const { titleKey, num } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
---
<Base title={t(titleKey)}>
  <section class="wrap">
    <div class="container">
      <div class="box">
        <p class="meta">[ /{num} {t(titleKey)} ]</p>
        <h1 class="display">{t(titleKey)}</h1>
        <p class="status"><i class="pixel"></i>{t('wip')}</p>
        <div class="bar"><i></i></div>
        <a href={href(lang, '/')} class="btn">← {t('btn.home')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .wrap { padding-block: clamp(40px, 10vw, 120px); }
  .box { padding: clamp(20px, 4vw, 48px); display: grid; gap: 24px; justify-items: start; }
  h1 { font-size: clamp(32px, 6.5vw, 90px); overflow-wrap: anywhere; }
  .status { display: flex; align-items: center; gap: 10px; }
  .bar { width: 100%; height: 6px; background: var(--paper-2); }
  .bar i { display: block; height: 100%; width: 20%; background: var(--orange); }
</style>

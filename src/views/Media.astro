---
// /media, as frames. A fixed bar holds the three tabs (music · visual · marketing); each tab runs
// as its own sequence: an index frame, then for every work a cover frame (image + details)
// followed by its gallery, one to three images per frame. Tabs are client-side, so
// /media?tab=visual&work=warcross links work on a static host.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { getLang, useT } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const vi = lang === 'vi';

const all = (await getCollection('works')).sort(
  (a, b) => a.data.order - b.data.order || b.data.sort - a.data.sort || a.data.title.localeCompare(b.data.title),
);

const tabs = [
  { id: 'music', label: t('media.music') },
  { id: 'visual', label: t('media.visual') },
  { id: 'marketing', label: t('media.marketing') },
] as const;

const groupLabel: Record<string, string> = vi
  ? { live: 'Biểu diễn', producing: 'Sản xuất', graphic: 'Đồ họa', web: 'Web', '3d': '3D', marketing: 'Marketing' }
  : { live: 'Live', producing: 'Production', graphic: 'Graphic', web: 'Web', '3d': '3D', marketing: 'Marketing' };

const L = {
  title: vi ? 'Tác phẩm.' : 'Work.',
  client: vi ? 'Khách hàng / Dự án' : 'Client / Project',
  role: vi ? 'Vai trò' : 'Role',
  year: vi ? 'Năm' : 'Year',
  type: vi ? 'Loại' : 'Type',
  results: vi ? 'Kết quả' : 'Results',
  next: vi ? 'Tác phẩm tiếp theo' : 'Next work',
  gallery: vi ? 'Xem ảnh' : 'Gallery',
};
const linkLabel = (cat: string) => (cat === 'music' ? t('btn.listen') : t('btn.visit'));

// Gallery → frames: fill a row while the images' aspect ratios add up to what a wide screen
// holds at full height (≈2.6), at most three per frame. Every image keeps its proportions.
function rows(gallery: ImageMetadata[]) {
  const out: ImageMetadata[][] = [];
  let row: ImageMetadata[] = [];
  let sum = 0;
  for (const g of gallery) {
    const a = g.width / g.height;
    if (row.length && (row.length === 3 || sum + a > 2.6)) { out.push(row); row = []; sum = 0; }
    row.push(g);
    sum += a;
  }
  if (row.length) out.push(row);
  return out;
}

const byTab = Object.fromEntries(tabs.map((tb) => [tb.id, all.filter((w) => w.data.category === tb.id)]));
const groupsFor = (cat: string) => [...new Set(byTab[cat].map((w) => w.data.group))];
---
<Base title={t('nav.media')}>
  <nav class="m-bar" aria-label={t('nav.media')}>
    <div class="container m-bar-in">
      <div class="m-tabs" role="tablist">
        {tabs.map((tb, i) => (
          <button role="tab" class="m-tab" data-tab={tb.id} aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="num">{i + 1}.</span>{tb.label}<span class="m-count">{byTab[tb.id].length}</span>
          </button>
        ))}
      </div>
      {tabs.map((tb) => {
        const groups = groupsFor(tb.id);
        return groups.length > 1 && (
          <div class="m-groups" data-for={tb.id} hidden>
            {groups.map((g) => {
              const first = byTab[tb.id].find((w) => w.data.group === g)!;
              return <a class="chip" href={`#work-${first.id}`}>{groupLabel[g]}</a>;
            })}
          </div>
        );
      })}
    </div>
  </nav>

  {tabs.map((tb) => (
    <>
      <Frame class="m-frame m-index" inner="container m-in" data-tab={tb.id}>
        <h1 class="display m-title" data-enter="rise"><span class="line"><span>{L.title}</span></span></h1>
        <ol class="m-list">
          {byTab[tb.id].map((w, i) => (
            <li data-enter>
              <a href={`#work-${w.id}`}>
                <span class="num">{i + 1}.</span>
                <span class="display m-list-title">{w.data.title}</span>
                <span class="meta">{w.data.kind[lang]}{w.data.year[lang] && ` · ${w.data.year[lang]}`}</span>
              </a>
            </li>
          ))}
        </ol>
      </Frame>

      {byTab[tb.id].map((w, wi) => {
        const nextWork = byTab[tb.id][wi + 1];
        const gallery = rows(w.data.gallery);
        const nextLink = nextWork && (
          <a class="m-next" href={`#work-${nextWork.id}`}>{L.next}: {nextWork.data.title} ↓</a>
        );
        return (
          <>
            <Frame as="article" class="m-frame m-cover" inner="container m-in m-cover-in" id={`work-${w.id}`} data-tab={tb.id} data-work={w.id}>
              <div class="m-cover-media" data-enter>
                {w.data.cover ? (
                  <Image src={w.data.cover} alt={w.data.title} widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 52vw, 90vw" style={`--r:${w.data.cover.width / w.data.cover.height}`} />
                ) : (
                  <div class="m-type"><span class="display">{w.data.title}</span></div>
                )}
              </div>
              <div class="m-info">
                <p class="meta" data-enter>{groupLabel[w.data.group]}</p>
                <h2 class="display m-name" data-enter="rise"><span class="line"><span>{w.data.title}</span></span></h2>
                <dl class="m-meta meta" data-enter>
                  <div><dt>{L.type}</dt><dd>{w.data.kind[lang]}</dd></div>
                  {w.data.client && <div><dt>{L.client}</dt><dd>{w.data.client[lang]}</dd></div>}
                  <div><dt>{L.role}</dt><dd>{w.data.role[lang]}</dd></div>
                  {w.data.year[lang] && <div><dt>{L.year}</dt><dd>{w.data.year[lang]}</dd></div>}
                </dl>
                <p class="m-desc" data-enter>{w.data.desc[lang]}</p>
                {w.data.results && (
                  <div class="m-results" data-enter>
                    <p class="meta">{L.results}</p>
                    <ul>{w.data.results[lang].split(' · ').map((r) => <li>{r}</li>)}</ul>
                  </div>
                )}
                {w.data.links.length > 0 && (
                  <div class="m-links" data-enter>
                    {w.data.links.map((l, i) => (
                      <a href={l.url} target="_blank" rel="noopener" class:list={['btn', i === 0 ? 'btn--signal' : '']}>
                        {i === 0 ? `${linkLabel(w.data.category)} · ${l.label}` : l.label} <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                )}
                {!gallery.length && nextLink}
              </div>
            </Frame>

            {gallery.map((row, ri) => (
              <Frame class="m-frame m-gallery" inner="container m-in m-gallery-in" data-tab={tb.id}>
                <div class="g-row">
                  {row.map((g, gi) => (
                    <figure class="g-item" data-enter style={`--a:${(g.width / g.height).toFixed(3)};--ia:${(g.height / g.width).toFixed(3)}`}>
                      <Image src={g} alt={`${w.data.title} ${ri * 3 + gi + 1}`} widths={[640, 1080, 1600]} sizes={row.length === 1 ? '(min-width: 1024px) 80vw, 100vw' : '(min-width: 1024px) 45vw, 100vw'} />
                    </figure>
                  ))}
                </div>
                <div class="g-foot meta">
                  <span>{w.data.title}</span>
                  {ri === gallery.length - 1 && nextLink}
                </div>
              </Frame>
            ))}
          </>
        );
      })}
    </>
  ))}
</Base>

<script>
  import { refresh, frameOf, goTo } from '../scripts/frames';

  const root = document.documentElement;
  const paged = root.classList.contains('paged');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.m-tab')];
  const valid = tabs.map((b) => b.dataset.tab!);
  const params = new URLSearchParams(location.search);
  const work = params.get('work');
  const workEl = work ? document.getElementById(`work-${work}`) : null;

  let tab = workEl?.dataset.tab ?? params.get('tab') ?? 'music';
  if (!valid.includes(tab)) tab = 'music';

  /** Show one tab's frames; land on frame n of it. */
  function show(next: string, n = 0) {
    tab = next;
    tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
    document.querySelectorAll<HTMLElement>('.m-groups').forEach((g) => (g.hidden = g.dataset.for !== tab));
    document.querySelectorAll<HTMLElement>('.m-frame').forEach((f) => (f.hidden = f.dataset.tab !== tab));
    if (paged) refresh(n);
    else scrollTo(0, 0);
  }

  tabs.forEach((b) => b.addEventListener('click', () => {
    if (b.dataset.tab === tab) return paged ? goTo(0) : scrollTo(0, 0);
    const url = new URL(location.href);
    url.searchParams.set('tab', b.dataset.tab!);
    url.searchParams.delete('work');
    history.replaceState({ ...(history.state ?? {}), frame: 0 }, '', url);
    show(b.dataset.tab!);
  }));

  // Arrive on the requested work (?work=), or where this tab was left (back/forward).
  show(tab);
  if (workEl) {
    if (paged) goTo(frameOf(workEl), { instant: true });
    else workEl.scrollIntoView();
  } else if (paged && typeof history.state?.frame === 'number') {
    goTo(history.state.frame, { instant: true });
  }
</script>

<style>
  /* Fixed bar under the header: tabs, plus jumps to each group in the current tab. */
  .m-bar {
    --bar-h: 56px;
    position: fixed; top: var(--header-h); left: 0; right: 0; z-index: 45;
    height: var(--bar-h);
    background: rgba(242, 242, 244, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .m-bar-in { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .m-tabs { display: flex; height: 100%; }
  .m-tab {
    position: relative;
    display: inline-flex; align-items: center; gap: 0.4em;
    padding: 0 18px 0 0; margin-right: 18px;
    font-family: var(--display); font-weight: 700; font-size: clamp(18px, 2vw, 26px);
    text-transform: uppercase; color: var(--stone);
    transition: color 0.2s;
  }
  .m-tab .num { font-family: var(--mono); font-weight: 400; font-size: 13px; color: #a9a9b3; }
  .m-tab[aria-selected='true'] { color: var(--ink); }
  .m-tab[aria-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--blue); }
  .m-tab:hover { color: var(--ink); }
  .m-count { font-family: var(--mono); font-size: 11px; font-weight: 400; color: var(--stone); }
  .m-groups { display: none; gap: 8px; }
  .chip {
    display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border: 1px solid var(--line);
    font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .chip:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .m-frame[hidden] { display: none; }
  /* Room for the bar on every media frame. */
  .m-frame :global(.m-in) { padding-top: calc(var(--header-h) + 56px + 3vh); padding-bottom: 4vh; justify-content: safe center; gap: 3vh; }

  /* Index */
  .m-title { font-size: clamp(56px, min(10vw, 16vh), 180px); font-weight: 800; }
  .m-list { list-style: none; padding: 0; border-top: 1px solid var(--ink); }
  .m-list a { display: grid; grid-template-columns: 2.4em 1fr; align-items: baseline; column-gap: 8px; padding-block: 10px; border-bottom: 1px solid var(--line); }
  .m-list .num { font-family: var(--mono); color: #a9a9b3; font-size: 13px; }
  .m-list-title { font-size: clamp(22px, min(2.6vw, 4.6vh), 40px); font-weight: 700; line-height: 1.05; transition: color 0.2s; }
  .m-list .meta { grid-column: 2; }
  .m-list a:hover .m-list-title { color: var(--blue); }

  /* Cover */
  .m-cover-media { align-self: flex-start; }
  .m-cover-media :global(img) {
    display: block;
    width: min(100%, calc(34svh * var(--r)));
    height: auto;
    box-shadow: 0 30px 60px -30px rgba(32, 32, 48, 0.45);
  }
  .m-type {
    width: min(100%, 44svh); aspect-ratio: 4 / 3; display: grid; place-items: end start; padding: 20px;
    background: linear-gradient(160deg, #4b3dff, var(--blue) 60%, #3529bf); color: #fff;
  }
  .m-type .display { font-size: clamp(32px, 4vw, 56px); font-weight: 800; line-height: 0.95; }
  .m-info { display: grid; gap: 14px; align-content: start; }
  .m-name { font-size: clamp(36px, min(4.6vw, 8vh), 72px); font-weight: 800; line-height: 0.95; }
  .m-meta { display: grid; gap: 6px; border-top: 1px solid var(--line); padding-top: 12px; }
  .m-meta div { display: grid; grid-template-columns: 9em 1fr; gap: 12px; }
  .m-meta dd { margin: 0; color: var(--ink); text-transform: none; letter-spacing: 0.02em; }
  .m-desc { max-width: 60ch; }
  .m-results ul { display: grid; gap: 4px; margin-top: 6px; }
  .m-results li { padding-left: 16px; position: relative; }
  .m-results li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; background: var(--orange); }
  .m-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .m-next { justify-self: start; color: var(--orange); border-bottom: 1px solid var(--orange); letter-spacing: 0.06em; }

  /* Gallery: images share the row by aspect ratio and are contained, never cropped. */
  .m-gallery :global(.m-gallery-in) { justify-content: flex-start; }
  .g-row { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 14px; }
  .g-item { margin: 0; flex: var(--ia) 1 0; min-height: 0; display: flex; align-items: center; justify-content: center; }
  .g-item :global(img) { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; box-shadow: 0 24px 48px -28px rgba(32, 32, 48, 0.45); }
  .g-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }

  @media (max-width: 767px) {
    .m-title { font-size: clamp(48px, 14vw, 72px); }
    .m-list a { padding-block: 7px; }
    .m-list-title { font-size: 22px; }
    .m-list .meta { font-size: 10px; }
    .m-cover-media :global(img) { width: min(100%, calc(28svh * var(--r))); }
    .m-desc { font-size: 14px; }
  }
  @media (min-width: 1024px) {
    .m-groups:not([hidden]) { display: flex; }
    .m-list { columns: 2; column-gap: 5vw; }
    .m-list li { break-inside: avoid; }
    .m-frame :global(.m-cover-in) { flex-direction: row; align-items: center; gap: 5vw; }
    .m-cover-media { align-self: center; flex: none; max-width: 56%; }
    .m-cover-media :global(img) { width: auto; max-width: 100%; max-height: 66svh; }
    .m-info { flex: 1; }
    .g-row { flex-direction: row; gap: 20px; }
    .g-item { flex: var(--a) 1 0; min-width: 0; }
  }
</style>

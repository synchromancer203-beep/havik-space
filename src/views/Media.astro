---
// /media: three tabs (music · visual · marketing), group filter, masonry of true-colour covers,
// and a lightbox per work. Tabs/filters are client-side so /media?tab=visual links work on a static host.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getLang, useT } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const vi = lang === 'vi';

const all = (await getCollection('works')).sort(
  (a, b) => a.data.order - b.data.order || b.data.sort - a.data.sort || a.data.title.localeCompare(b.data.title),
);

const tabs = [
  { id: 'music', label: t('media.music') },
  { id: 'visual', label: t('media.visual') },
  { id: 'marketing', label: t('media.marketing') },
] as const;

const groupLabel: Record<string, string> = vi
  ? { live: 'Biểu diễn', producing: 'Sản xuất', graphic: 'Đồ họa', web: 'Web', '3d': '3D', marketing: 'Marketing' }
  : { live: 'Live', producing: 'Production', graphic: 'Graphic', web: 'Web', '3d': '3D', marketing: 'Marketing' };

// Only offer group filters that actually have work in them.
const groupsFor = (cat: string) => [...new Set(all.filter((w) => w.data.category === cat).map((w) => w.data.group))];
const L = {
  all: vi ? 'Tất cả' : 'All',
  close: vi ? 'Đóng' : 'Close',
  client: vi ? 'Khách hàng / Dự án' : 'Client / Project',
  role: vi ? 'Vai trò' : 'Role',
  year: vi ? 'Năm' : 'Year',
  type: vi ? 'Loại' : 'Type',
  results: vi ? 'Kết quả' : 'Results',
  count: (n: number) => (vi ? `${n} tác phẩm` : `${n} works`),
};
const linkLabel = (cat: string) => (cat === 'music' ? t('btn.listen') : t('btn.visit'));
---
<Base title={t('nav.media')}>
  <section class="media">
    <div class="container">
      <header class="m-head">
        <h1 class="display">{vi ? 'Tác phẩm.' : 'Work.'}</h1>
        <p class="meta">{L.count(all.length)}</p>
      </header>

      <div class="m-tabs" role="tablist">
        {tabs.map((tb, i) => (
          <button role="tab" class="m-tab" data-tab={tb.id} aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="num">{i + 1}.</span>{tb.label}
            <span class="m-count">{all.filter((w) => w.data.category === tb.id).length}</span>
          </button>
        ))}
      </div>

      {tabs.map((tb) => {
        const groups = groupsFor(tb.id);
        return groups.length > 1 && (
          <div class="m-filters" data-for={tb.id} hidden>
            <button class="chip" data-group="all" aria-pressed="true">{L.all}</button>
            {groups.map((g) => <button class="chip" data-group={g} aria-pressed="false">{groupLabel[g]}</button>)}
          </div>
        );
      })}

      <ul class="grid">
        {all.map((w) => (
          <li class="card" data-cat={w.data.category} data-group={w.data.group}>
            <button class="card-btn" data-open={w.id} aria-haspopup="dialog">
              <div class="card-media">
                {w.data.cover ? (
                  <Image src={w.data.cover} alt={w.data.title} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
                ) : (
                  <div class="card-type"><span class="display">{w.data.title}</span></div>
                )}
                <span class="card-view">{t('card.view')}</span>
              </div>
              <div class="card-info">
                <h2 class="card-title display">{w.data.title}</h2>
                <p class="meta">{w.data.kind[lang]}{w.data.year[lang] && ` · ${w.data.year[lang]}`}</p>
              </div>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- One lightbox, filled from the matching template on open. -->
  <dialog class="lb" aria-label="">
    <div class="lb-inner" data-lenis-prevent>
      <button class="lb-close btn" aria-label={L.close}>{L.close} ✕</button>
      <div class="lb-body"></div>
    </div>
  </dialog>

  {all.map((w) => (
    <template id={`work-${w.id}`}>
      <article class="lb-work">
        <div class="lb-media">
          {w.data.cover && (
            <Image src={w.data.cover} alt={w.data.title} widths={[800, 1400, 2000]} sizes="(min-width: 1024px) 62vw, 100vw" loading="lazy" />
          )}
          {w.data.gallery.map((g, i) => (
            <Image src={g} alt={`${w.data.title} ${i + 1}`} widths={[800, 1400, 2000]} sizes="(min-width: 1024px) 62vw, 100vw" loading="lazy" />
          ))}
          {!w.data.cover && !w.data.gallery.length && (
            <div class="card-type lb-type"><span class="display">{w.data.title}</span></div>
          )}
        </div>
        <aside class="lb-info">
          <p class="meta">{groupLabel[w.data.group]}</p>
          <h2 class="display">{w.data.title}</h2>
          <dl class="lb-meta meta">
            <div><dt>{L.type}</dt><dd>{w.data.kind[lang]}</dd></div>
            {w.data.client && <div><dt>{L.client}</dt><dd>{w.data.client[lang]}</dd></div>}
            <div><dt>{L.role}</dt><dd>{w.data.role[lang]}</dd></div>
            {w.data.year[lang] && <div><dt>{L.year}</dt><dd>{w.data.year[lang]}</dd></div>}
          </dl>
          <p class="lb-desc">{w.data.desc[lang]}</p>
          {w.data.results && (
            <div class="lb-results">
              <p class="meta">{L.results}</p>
              <ul>{w.data.results[lang].split(' · ').map((r) => <li>{r}</li>)}</ul>
            </div>
          )}
          {w.data.links.length > 0 && (
            <div class="lb-links">
              {w.data.links.map((l, i) => (
                <a href={l.url} target="_blank" rel="noopener" class:list={['btn', i === 0 ? 'btn--signal' : '']}>
                  {i === 0 ? `${linkLabel(w.data.category)} · ${l.label}` : l.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </aside>
      </article>
    </template>
  ))}
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.m-tab')];
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const filterBars = [...document.querySelectorAll<HTMLElement>('.m-filters')];
  const valid = ['music', 'visual', 'marketing'];

  let tab = new URLSearchParams(location.search).get('tab') ?? 'music';
  if (!valid.includes(tab)) tab = 'music';
  let group = 'all';

  function render() {
    tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
    filterBars.forEach((f) => {
      f.hidden = f.dataset.for !== tab;
      f.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.group === group)));
    });
    cards.forEach((c) => {
      c.hidden = c.dataset.cat !== tab || (group !== 'all' && c.dataset.group !== group);
    });
    (window as any).ScrollTrigger?.refresh?.();
  }

  tabs.forEach((b) => b.addEventListener('click', () => {
    tab = b.dataset.tab!;
    group = 'all';
    const url = new URL(location.href);
    url.searchParams.set('tab', tab);
    history.replaceState(null, '', url);
    render();
  }));
  filterBars.forEach((f) => f.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!chip) return;
    group = chip.dataset.group!;
    render();
  }));
  render();

  // Lightbox
  const dialog = document.querySelector<HTMLDialogElement>('.lb')!;
  const body = dialog.querySelector('.lb-body')!;
  const lenis = () => (window as any).__lenis;
  let opener: HTMLElement | null = null;

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-open]');
    if (!btn) return;
    const tpl = document.getElementById(`work-${btn.dataset.open}`) as HTMLTemplateElement | null;
    if (!tpl) return;
    opener = btn;
    body.replaceChildren(tpl.content.cloneNode(true));
    dialog.setAttribute('aria-label', btn.querySelector('.card-title')?.textContent ?? '');
    dialog.querySelector('.lb-inner')!.scrollTop = 0;
    lenis()?.stop();
    dialog.showModal();
  });
  const close = () => dialog.close();
  dialog.querySelector('.lb-close')!.addEventListener('click', close);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
  dialog.addEventListener('close', () => { lenis()?.start(); body.replaceChildren(); opener?.focus(); });

  // Deep link: /media?tab=music&work=beach-heaven opens that work straight away.
  const deep = new URLSearchParams(location.search).get('work');
  if (deep) document.querySelector<HTMLButtonElement>(`[data-open="${CSS.escape(deep)}"]`)?.click();
</script>

<style>
  .media { padding-block: clamp(40px, 8vh, 96px) 16vh; }
  .m-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 40px; }
  .m-head h1 { font-size: clamp(64px, 11vw, 180px); font-weight: 800; }

  .m-tabs { display: flex; flex-wrap: wrap; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .m-tab {
    position: relative;
    display: inline-flex; align-items: baseline; gap: 0.4em;
    padding: 18px 22px 16px 0; margin-right: 22px;
    font-family: var(--display); font-weight: 700; font-size: clamp(22px, 2.6vw, 36px);
    text-transform: uppercase; color: var(--stone);
    transition: color 0.2s;
  }
  .m-tab .num { color: #a9a9b3; }
  .m-tab[aria-selected='true'] { color: var(--ink); }
  .m-tab[aria-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--blue); }
  .m-tab:hover { color: var(--ink); }
  .m-count { font-family: var(--mono); font-size: 12px; font-weight: 400; color: var(--stone); }

  .m-filters { display: flex; flex-wrap: wrap; gap: 8px; padding-block: 20px 4px; }
  .m-filters[hidden] { display: none; }
  .chip {
    height: 34px; padding: 0 14px; border: 1px solid var(--line);
    font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  /* Masonry via columns: every cover keeps its own proportions. */
  .grid { columns: 1; column-gap: 24px; margin-top: 32px; }
  .card { break-inside: avoid; margin-bottom: 32px; }
  .card[hidden] { display: none; }
  .card-btn { display: block; width: 100%; text-align: left; }
  .card-media { position: relative; overflow: hidden; box-shadow: 0 24px 48px -28px rgba(32, 32, 48, 0.45); }
  .card-media :global(img) { display: block; width: 100%; height: auto; transition: transform 0.8s var(--ease-out); }
  .card-btn:hover .card-media :global(img) { transform: scale(1.03); }
  .card-view {
    position: absolute; right: 12px; bottom: 12px;
    padding: 6px 10px; background: var(--orange); color: var(--paper);
    font-size: 12px; letter-spacing: 0.08em;
    opacity: 0; transform: translateY(6px); transition: opacity 0.25s, transform 0.25s;
  }
  .card-btn:hover .card-view, .card-btn:focus-visible .card-view { opacity: 1; transform: none; }
  .card-type {
    aspect-ratio: 4 / 3; display: grid; place-items: end start; padding: 20px;
    background: linear-gradient(160deg, #4b3dff, var(--blue) 60%, #3529bf); color: #fff;
  }
  .card-type .display { font-size: clamp(36px, 4vw, 56px); font-weight: 800; line-height: 0.95; }
  .card-info { padding-top: 14px; display: grid; gap: 4px; }
  .card-title { font-size: clamp(24px, 2.2vw, 32px); font-weight: 700; line-height: 1; }
  .card-btn:hover .card-title { color: var(--blue); }

  /* Lightbox */
  .lb {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: var(--paper-2); color: var(--ink);
  }
  .lb::backdrop { background: rgba(32, 32, 48, 0.4); }
  .lb[open] { animation: lb-in 0.4s var(--ease-out); }
  @keyframes lb-in { from { opacity: 0; transform: translateY(16px); } }
  .lb-inner { height: 100%; overflow-y: auto; overscroll-behavior: contain; }
  .lb-close { position: fixed; top: 16px; right: 16px; z-index: 2; background: var(--paper); }
  .lb-body :global(.lb-work) { display: grid; gap: 32px; padding: 72px var(--gutter) 64px; max-width: var(--max); margin-inline: auto; }
  .lb-body :global(.lb-media) { display: grid; gap: 16px; }
  .lb-body :global(.lb-media img) { display: block; width: 100%; height: auto; }
  /* Info first on small screens, beside the images (sticky) on desktop. */
  .lb-body :global(.lb-info) { display: grid; gap: 18px; align-content: start; order: -1; }
  .lb-body :global(.lb-info h2) { font-size: clamp(40px, 5vw, 72px); font-weight: 800; line-height: 0.92; }
  .lb-body :global(.lb-meta) { display: grid; gap: 8px; border-top: 1px solid var(--line); padding-top: 16px; }
  .lb-body :global(.lb-meta div) { display: grid; grid-template-columns: 9em 1fr; gap: 12px; }
  .lb-body :global(.lb-meta dd) { margin: 0; color: var(--ink); text-transform: none; letter-spacing: 0.02em; }
  .lb-body :global(.lb-desc) { max-width: 60ch; }
  .lb-body :global(.lb-results ul) { display: grid; gap: 6px; margin-top: 8px; }
  .lb-body :global(.lb-results li) { padding-left: 16px; position: relative; }
  .lb-body :global(.lb-results li::before) { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; background: var(--orange); }
  .lb-body :global(.lb-links) { display: flex; flex-wrap: wrap; gap: 10px; }

  @media (min-width: 640px) { .grid { columns: 2; } }
  @media (min-width: 1024px) {
    .grid { columns: 3; column-gap: 32px; }
    .lb-body :global(.lb-work) { grid-template-columns: 1.7fr 1fr; gap: 56px; }
    .lb-body :global(.lb-info) { position: sticky; top: 72px; order: 0; }
  }
</style>

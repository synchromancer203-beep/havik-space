---
// /blog/<slug>: one post as frames. Head: date, title and the cover (with a second photo beside it
// when the post has one). Body: the text in a reading
// column (it scrolls inside its frame), then a link back to the list. Footer last.
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { getLang, href } from '../i18n/utils';
import { formatDate, type Post } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;
const lang = getLang(Astro.url);
const vi = lang === 'vi';
const { Content } = await render(post);
// Share image: the cover, as a 1200px JPEG.
const share = await getImage({ src: post.data.cover, width: 1200, format: 'jpg' });
// Head photos side by side at the same height: each column as wide as its photo's proportions.
const shots = [
  { src: post.data.cover, alt: post.data.coverAlt },
  ...(post.data.cover2 ? [{ src: post.data.cover2, alt: post.data.cover2Alt ?? '' }] : []),
].map((s) => ({ ...s, r: s.src.width / s.src.height }));
const r = shots.reduce((a, s) => a + s.r, 0);
---
<Base title={post.data.title} description={post.data.description} image={share.src}>
  <Frame class="ph" inner="container ph-in">
    <div class="ph-text">
      <span class="meta" data-enter>{formatDate(post.data.date, lang)}</span>
      <h1 class="display ph-title" data-enter="rise"><span class="line"><span>{post.data.title}</span></span></h1>
    </div>
    <div class="ph-cover" data-enter data-depth style={`--r:${r};--n:${shots.length};grid-template-columns:${shots.map((x) => `${x.r}fr`).join(' ')}`}>
      {shots.map((x) => (
        <div class="ph-shot"><Image src={x.src} alt={x.alt} widths={[640, 1080, 1600]} sizes={`(min-width: 1024px) ${Math.round(50 / shots.length)}vw, ${Math.round(100 / shots.length)}vw`} loading="eager" /></div>
      ))}
    </div>
  </Frame>

  <Frame class="pb" inner="container pb-in">
    <article class="prose">
      <Content />
    </article>
    <a href={href(lang, '/blog')} class="pb-back meta"><span aria-hidden="true">←</span> {vi ? 'Tất cả bài viết' : 'All posts'}</a>
  </Frame>
</Base>

<style>
  /* Head: title beside the cover on desktop, above it on phones. */
  .ph :global(.ph-in) { padding-top: calc(var(--header-h) + 3vh); padding-bottom: 5vh; justify-content: safe center; gap: 4vh; }
  .ph-text { display: grid; gap: 16px; }
  .ph-title { font-size: clamp(44px, min(6.4vw, 11vh), 120px); font-weight: 800; line-height: 1; text-wrap: balance; }
  /* The mask's room for stacked marks (Ồ, Ữ) is on .line; long titles wrap inside it. */
  .ph-title .line > span { display: inline; }
  /* The row's width is the photos' summed proportions times its height, plus the gaps. */
  .ph-cover { --g: 12px; display: grid; gap: var(--g); width: min(100%, calc(40svh * var(--r) + (var(--n) - 1) * var(--g))); }
  .ph-shot { box-shadow: 0 30px 60px -30px rgba(32, 32, 48, 0.45); }
  .ph-shot :global(img) { display: block; width: 100%; height: auto; }

  /* Body: a reading column. */
  .pb :global(.pb-in) { padding-top: calc(var(--header-h) + 6vh); padding-bottom: 10vh; gap: 48px; align-items: center; }
  .prose { width: 100%; max-width: 62ch; font-size: clamp(15px, 1.1vw, 17px); line-height: 1.8; }
  .prose :global(p) { margin: 0 0 1.4em; }
  .prose :global(p:has(> img)) { margin: 2.4em 0; }
  .prose :global(img) { display: block; width: 100%; height: auto; box-shadow: 0 30px 60px -30px rgba(32, 32, 48, 0.45); }
  .pb-back { align-self: flex-start; width: 100%; max-width: 62ch; margin-inline: auto; }
  .pb-back:hover { color: var(--blue); }

  @media (min-width: 1024px) {
    .ph :global(.ph-in) { flex-direction: row; align-items: center; gap: 5vw; }
    .ph-text { flex: 1; }
    .ph-cover { flex: none; width: min(50vw, calc(64svh * var(--r) + (var(--n) - 1) * var(--g))); }
  }
</style>

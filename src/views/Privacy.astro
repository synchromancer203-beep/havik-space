---
import Base from '../layouts/Base.astro';
import { getLang, useT } from '../i18n/utils';
import { site } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = useT(lang);
---
<Base title={t('footer.privacy')}>
  <section class="container wrap">
    <p class="meta">[ DOC · PRIVACY · 2026 ]</p>
    <h1 class="display">{t('footer.privacy')}</h1>
    {lang === 'vi' ? (
      <div class="body">
        <p>Trang này không có form, không dùng cookie theo dõi và không thu thập dữ liệu cá nhân của bạn.</p>
        <p>Khi bạn bấm vào link mạng xã hội hoặc trình phát nhạc nhúng (Spotify, Bandcamp), các dịch vụ đó áp dụng chính sách riêng của họ.</p>
        <p>Thắc mắc: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    ) : (
      <div class="body">
        <p>This site has no forms, uses no tracking cookies and collects no personal data.</p>
        <p>Social links and embedded players (Spotify, Bandcamp) are covered by those services' own policies.</p>
        <p>Questions: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    )}
  </section>
</Base>

<style>
  .wrap { padding-block: clamp(40px, 8vw, 96px); }
  h1 { font-size: clamp(28px, 4.5vw, 60px); margin: 16px 0 32px; }
  .body { max-width: 64ch; display: grid; gap: 16px; }
  .body a { border-bottom: 1px solid var(--blue); }
</style>

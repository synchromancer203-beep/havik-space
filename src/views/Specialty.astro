---
// /specialties/{music|visual|marketing}, as frames: head + image → services (or one frame per group) →
// skills & people → related work, four per frame → actions + next field → footer.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ink from '../components/Ink.astro';
import WorkCard from '../components/WorkCard.astro';
import Frame from '../components/Frame.astro';
import { specialties, type Specialty } from '../data/specialties';
import { getLang, useT, href } from '../i18n/utils';
import musicHero from '../assets/personal/music-hero.jpg';
import wcCover from '../content/works/warcross/cover.webp';
import nobCover from '../content/works/nob-network/cover.jpg';

interface Props { id: Specialty['id']; }
const { id } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
const vi = lang === 'vi';

const idx = specialties.findIndex((s) => s.id === id);
const sp = specialties[idx];
const next = specialties[(idx + 1) % specialties.length];
const title = t(`spec.${id}` as const);

// Personal photo → riso print; work images stay true colour.
const heroImg = { music: musicHero, visual: wcCover, marketing: nobCover }[id];
const heroRiso = id === 'music';

const works = (await getCollection('works'))
  .sort((a, b) => a.data.order - b.data.order || b.data.sort - a.data.sort);
const byCat = works.filter((w) => w.data.category === id);
const forGroup = (g: string, extra: string[] = []) =>
  works.filter((w) => (w.data.category === id && w.data.group === g) || extra.includes(w.id));

// Four works per frame, so a frame always fits the screen.
const chunk = <T,>(a: T[], n = 4) => Array.from({ length: Math.ceil(a.length / n) }, (_, i) => a.slice(i * n, i * n + n));

const L = {
  services: vi ? 'Dịch vụ' : 'Services',
  skills: vi ? 'Kỹ năng' : 'Skills',
  work: vi ? 'Tác phẩm' : 'Work',
  next: vi ? 'Tiếp theo' : 'Next',
};
---
<Base title={title}>
  <Frame class="sp-head" inner="container sp-head-in">
    <div class="sp-head-text">
      <p class="meta" data-enter>{idx + 1}. {t('nav.specialties')}</p>
      <h1 class="display" data-enter="rise"><span class="line"><span>{title}</span></span></h1>
      <p class="sp-intro" data-enter>{sp.intro[lang]}</p>
    </div>
    <div class="sp-hero" style={`--r:${heroImg.width / heroImg.height}`} data-enter>
      {heroRiso
        ? <Ink src={heroImg} alt={title} widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 50vw, 90vw" loading="eager" contrast={1.5} />
        : <Image src={heroImg} alt={title} widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 50vw, 90vw" loading="eager" />}
    </div>
  </Frame>

  {sp.services && (
    <Frame class="block" inner="container block-in">
      <h2 class="meta block-label" data-enter>{L.services}</h2>
      <ol class="services">
        {sp.services[lang].map((s, i) => (
          <li data-enter><span class="num">{i + 1}.</span><span class="display">{s}</span></li>
        ))}
      </ol>
    </Frame>
  )}

  {sp.groups?.map((g, gi) => {
    const [first = [], ...more] = chunk(forGroup(g.id, g.extraWorks), 3);
    return (
      <>
        <Frame class="block group" inner="container block-in">
          <h2 class="display group-title" data-enter="rise"><span class="num">{gi + 1}.</span><span class="line"><span>{g.title[lang]}</span></span></h2>
          <ol class="services services--sm">
            {g.services[lang].map((s) => <li data-enter><span class="display">{s}</span></li>)}
          </ol>
          {first.length > 0 && <ul class="works works--3">{first.map((w) => <li data-enter><WorkCard work={w} /></li>)}</ul>}
        </Frame>
        {more.map((list) => (
          <Frame class="block" inner="container block-in">
            <ul class="works works--3">{list.map((w) => <li data-enter><WorkCard work={w} /></li>)}</ul>
          </Frame>
        ))}
      </>
    );
  })}

  <Frame class="block split" inner="container block-in split-in">
    <div>
      <h2 class="meta block-label" data-enter>{L.skills}</h2>
      <ul class="chips" data-enter>{sp.skills.map((s) => <li>{s}</li>)}</ul>
    </div>
    {sp.people && sp.peopleLabel && (
      <div>
        <h2 class="meta block-label" data-enter>{sp.peopleLabel[lang]}</h2>
        <p class="people display" data-enter>{sp.people.join(' · ')}</p>
      </div>
    )}
  </Frame>

  {!sp.groups && chunk(byCat).map((list, ci) => (
    <Frame class="block" inner="container block-in">
      {ci === 0 && <h2 class="meta block-label" data-enter>{L.work}</h2>}
      <ul class="works">{list.map((w) => <li data-enter><WorkCard work={w} /></li>)}</ul>
    </Frame>
  ))}

  <Frame class="block end" inner="container block-in end-in">
    <div class="actions" data-enter>
      <a href={href(lang, `/media?tab=${id}`)} class="btn btn--signal">{t('btn.viewAll')} <span aria-hidden="true">↗</span></a>
      <a href={href(lang, '#contact')} class="btn">{t('cta')}</a>
    </div>
    <a href={href(lang, next.path)} class="next" data-enter>
      <span class="meta">{L.next} ↓</span>
      <span class="display next-title">{t(`spec.${next.id}` as const)}</span>
    </a>
  </Frame>
</Base>

<style>
  .sp-head :global(.sp-head-in) { justify-content: safe center; gap: 4vh; padding-bottom: 5vh; }
  .sp-head-text { display: grid; gap: 16px; align-content: center; }
  .sp-head h1 { font-size: clamp(64px, min(11vw, 18vh), 200px); font-weight: 800; text-transform: uppercase; line-height: 0.9; }
  .sp-intro { max-width: 52ch; }
  .sp-hero {
    aspect-ratio: var(--r);
    width: min(100%, calc(32svh * var(--r)));
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(32, 32, 48, 0.45);
  }
  .sp-hero :global(img), .sp-hero :global(.ink) { width: 100%; height: 100%; object-fit: cover; display: block; }

  .block :global(.block-in) { justify-content: safe center; padding-bottom: 5vh; }
  .block-label { margin-bottom: 20px; }

  .services { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .services li { display: flex; align-items: baseline; gap: 0.5em; padding-block: 12px; border-bottom: 1px solid var(--line); }
  .services .display { font-size: clamp(28px, min(4.4vw, 7vh), 64px); font-weight: 700; line-height: 1.05; }
  .services--sm .display { font-size: clamp(22px, min(2.6vw, 4.4vh), 38px); }
  .services--sm li { padding-block: 8px; }
  .num { font-family: var(--mono); color: #a9a9b3; font-size: clamp(14px, 1.2vw, 18px); }

  .group-title { display: flex; align-items: baseline; gap: 0.4em; font-size: clamp(40px, min(6vw, 10vh), 96px); font-weight: 800; text-transform: uppercase; margin-bottom: 16px; }

  .split :global(.split-in) { gap: 48px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; }
  .chips li { border: 1px solid var(--ink); padding: 8px 14px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .people { font-size: clamp(24px, 3vw, 44px); font-weight: 600; line-height: 1.2; }

  /* Covers keep their proportions and are capped in height so a row fits the frame. */
  .works { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 24px 20px; align-items: end; margin-top: 20px; }
  .works :global(.wc-media) { width: fit-content; max-width: 100%; }
  .works :global(.wc-media img) { width: auto; max-width: 100%; max-height: 22svh; }
  .works :global(.wc-type) { height: 22svh; aspect-ratio: 4 / 3; }

  .end :global(.end-in) { gap: 8vh; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .next { display: grid; gap: 8px; border-top: 1px solid var(--line); padding-top: 32px; }
  .next-title { font-size: clamp(64px, min(11vw, 18vh), 180px); font-weight: 800; text-transform: uppercase; line-height: 0.9; transition: color 0.3s; }
  .next:hover .next-title { color: var(--blue); }

  @media (min-width: 1024px) {
    .sp-head :global(.sp-head-in) { flex-direction: row; align-items: center; gap: 5vw; }
    .sp-head-text { flex: 1; }
    .sp-hero { width: min(48vw, calc(64svh * var(--r))); flex: none; }
    .split :global(.split-in) { flex-direction: row; align-items: center; }
    .split :global(.split-in) > :global(*) { flex: 1; }
    .works { grid-template-columns: repeat(4, 1fr); gap: 28px; }
    .works--3 { grid-template-columns: repeat(3, 1fr); }
    .works :global(.wc-media img) { max-height: 40svh; }
    .works :global(.wc-type) { height: 32svh; }
    .group .works :global(.wc-media img) { max-height: 28svh; }
  }
</style>

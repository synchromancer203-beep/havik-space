---
// Home. Motion: scroll-driven only (ref marcuslorenzet).
// Riso one-ink print only on the hero; everything else keeps its real colours.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ink from '../components/Ink.astro';
import chanDung from '../assets/personal/chan-dung.webp';
import liveNov from '../assets/personal/live-novation.jpg';
import musicHero from '../assets/personal/music-hero.jpg';
import musicLive from '../assets/personal/music-live.jpg';
import hero from '../assets/home/hero-portrait.jpg';
import cm from '../assets/work/corrupted-moonlight.webp';
import bh from '../assets/work/beach-heaven.webp';
import wc from '../assets/work/warcross.webp';
import nob from '../assets/work/nob-network.jpg';
import open from '../assets/work/open.webp';
import cm05 from '../assets/collage/cm-05.png';
import cm09 from '../assets/collage/cm-09.webp';
import cm13 from '../assets/collage/cm-13.webp';
import mk02 from '../assets/collage/mukang-02.jpg';
import { getLang, useT, href } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const vi = lang === 'vi';

const fields = [
  { key: 'spec.music', path: '/specialties/music' },
  { key: 'spec.visual', path: '/specialties/visual' },
  { key: 'spec.marketing', path: '/specialties/marketing' },
] as const;

// Collage behind the three fields: 12 photos, each shown once, hand-placed with breathing
// room. One layer drifts up at roughly scroll speed while the stage is pinned.
// [left %, top vw, width vw] — all in width units so gaps hold at any screen ratio.
const tiles = [
  { src: chanDung,  d: [5, 2, 17],   m: [4, 0, 38] },
  { src: musicHero, d: [32, 6, 21],  m: [54, 8, 42] },
  { src: cm09,      d: [64, 0, 13],  m: [10, 46, 30] },
  { src: open,      d: [81, 8, 16],  m: [52, 47, 44] },
  { src: liveNov,   d: [12, 26, 21], m: [52, 84, 42] },
  { src: cm05,      d: [40, 27, 13], m: [4, 94, 34] },
  { src: nob,       d: [58, 24, 19], m: [46, 117, 46] },
  { src: wc,        d: [83, 25, 12], m: [6, 136, 32] },
  { src: musicLive, d: [3, 46, 22],  m: [48, 156, 46] },
  { src: mk02,      d: [30, 44, 18], m: [4, 185, 42] },
  { src: cm,        d: [54, 47, 20], m: [52, 190, 42] },
  { src: cm13,      d: [82, 45, 12], m: [24, 222, 30] },
];

// Featured work comes from the content collection (featured: true), in the order music → visual → marketing.
const catOrder = { music: 0, visual: 1, marketing: 2 };
const featured = (await getCollection('works', (w) => w.data.featured && !!w.data.cover))
  .sort((a, b) => catOrder[a.data.category] - catOrder[b.data.category] || a.data.order - b.data.order || b.data.sort - a.data.sort)
  .map((w) => ({
    id: w.id,
    img: w.data.cover!,
    title: w.data.title,
    kind: w.data.kind[lang],
    role: w.data.role[lang],
    year: w.data.year[lang],
    tab: w.data.category,
  }));
---
<Base flush>
  <!-- HERO: dark portrait plate; the next section slides over it like a curtain -->
  <section class="hero" data-theme="dark">
    <div class="hero-photo">
      <div class="hero-photo-in">
        <Ink src={hero} alt="Havik" widths={[720, 1080]} sizes="(min-width: 768px) 60vh, 100vw" loading="eager" contrast={1.7} />
      </div>
    </div>

    <h1 class="display hero-name" aria-label="Havik">
      <span class="line"><span>HAVIK</span></span>
    </h1>

    <a href={href(lang, '/media')} class="btn btn--signal hero-cta">{t('btn.viewWork')} <span aria-hidden="true">↗</span></a>
  </section>

  <!-- FIELDS: three words over a drifting collage; the words invert wherever a photo passes beneath -->
  <section class="fields">
    <div class="f-stage">
      <div class="collage" aria-hidden="true">
        {tiles.map((tl) => (
          <div
            class="tile"
            style={`--dx:${tl.d[0]}%;--dy:${tl.d[1]}vw;--dw:${tl.d[2]}vw;--mx:${tl.m[0]}%;--my:${tl.m[1]}vw;--mw:${tl.m[2]}vw;aspect-ratio:${tl.src.width}/${tl.src.height}`}
          >
            <Image src={tl.src} alt="" widths={[400, 720]} sizes="(min-width: 768px) 24vw, 48vw" />
          </div>
        ))}
      </div>
      <ul class="container f-list">
        {fields.map((f, i) => (
          <li>
            <a href={href(lang, f.path)} class="f-word">
              <span class="f-num">{i + 1}.</span>
              <span class="display">{t(f.key)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="selected">
    <div class="container">
      <header class="sel-head">
        <h2 class="display"><span class="line"><span>{vi ? 'Nổi bật.' : 'Selected.'}</span></span></h2>
        <p class="meta">[ {t('nav.media')} ]</p>
      </header>

      <ol class="cases">
        {featured.map((f, i) => (
          <li class="case">
            <a href={href(lang, `/media?tab=${f.tab}&work=${f.id}`)} class="case-link">
              <div class="case-media" style={`--r:${f.img.width / f.img.height}`}>
                <Image src={f.img} alt={f.title} widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 56vw, 100vw" />
              </div>
              <div class="case-info">
                <span class="case-num display">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="case-title display">{f.title}</h3>
                <dl class="case-meta meta">
                  <div><dt>Type</dt><dd>{f.kind}</dd></div>
                  <div><dt>Role</dt><dd>{f.role}</dd></div>
                  {f.year && <div><dt>Year</dt><dd>{f.year}</dd></div>}
                </dl>
                <span class="case-cta">{t('card.view')}</span>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <a href={href(lang, '/media')} class="btn btn--signal all">{t('btn.viewAll')} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<script>
  import { gsap } from '../scripts/smooth';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Load: portrait fades up, name rises out of its mask.
  gsap.from('.hero-photo-in', { opacity: 0, scale: 1.05, duration: 1.8, ease: 'power2.out' });
  gsap.from('.hero-name .line > span', { yPercent: 105, duration: 1.4, ease: 'expo.out', delay: 0.25 });
  gsap.from('.hero-cta', { y: 16, opacity: 0, duration: 0.8, ease: 'power3.out', delay: 0.9 });

  if (!reduce) {
    // Hero recedes while the next section slides over it.
    gsap.timeline({ scrollTrigger: { trigger: '.fields', start: 'top bottom', end: 'top top', scrub: true } })
      .to('.hero-photo', { scale: 1.1, yPercent: 6, ease: 'none' }, 0)
      .to('.hero-name', { yPercent: -35, ease: 'none' }, 0);

    // The three fields light up one after another.
    gsap.to('.f-word', {
      opacity: 1,
      stagger: 0.5,
      ease: 'none',
      scrollTrigger: { trigger: '.fields', start: 'top 20%', end: 'bottom bottom', scrub: true },
    });

    // While the stage is pinned, the collage layer rises from below to above the frame at
    // about scroll speed, so each photo passes through exactly once.
    gsap.fromTo('.collage', { y: () => innerHeight * 0.4 }, {
      y: () => -(document.querySelector<HTMLElement>('.collage')!.offsetHeight - innerHeight * 0.2),
      ease: 'none',
      scrollTrigger: { trigger: '.fields', start: 'top top', end: 'bottom bottom', scrub: true, invalidateOnRefresh: true },
    });

    gsap.from('.sel-head .line > span', {
      yPercent: 105, duration: 1.2, ease: 'expo.out',
      scrollTrigger: { trigger: '.sel-head', start: 'top 80%' },
    });

    // Each case: image opens from a narrow slit, content inside drifts.
    document.querySelectorAll<HTMLElement>('.case').forEach((c) => {
      gsap.fromTo(c.querySelector('.case-media'), { clipPath: 'inset(18% 12% 18% 12%)' }, {
        clipPath: 'inset(0% 0% 0% 0%)', ease: 'none',
        scrollTrigger: { trigger: c, start: 'top 95%', end: 'top 35%', scrub: true },
      });
      gsap.fromTo(c.querySelector('.case-media'), { y: 40 }, {
        y: -40, ease: 'none',
        scrollTrigger: { trigger: c, start: 'top bottom', end: 'bottom top', scrub: true },
      });
      gsap.from(c.querySelectorAll('.case-info > *'), {
        y: 40, opacity: 0, stagger: 0.08, ease: 'none',
        scrollTrigger: { trigger: c, start: 'top 80%', end: 'top 40%', scrub: true },
      });
    });
  } else {
    gsap.set('.f-word', { opacity: 1 });
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    --plate: #4334f4; /* Vivid Blue after the paper multiply in Ink, so the print melts into it */
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    z-index: 0;
    background: radial-gradient(70% 90% at 70% 40%, #4b3dff 0%, var(--plate) 70%);
    color: var(--paper);
  }
  .hero-photo {
    position: absolute; top: 0; bottom: 0; right: 8vw;
    aspect-ratio: 9 / 16;
    transform-origin: 50% 40%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 85%, transparent 100%), linear-gradient(to top, transparent 0%, #000 30%);
    -webkit-mask-composite: source-in;
            mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 85%, transparent 100%), linear-gradient(to top, transparent 0%, #000 30%);
            mask-composite: intersect;
  }
  .hero-photo-in, .hero-photo :global(.ink) { width: 100%; height: 100%; }

  .hero-name {
    position: absolute; left: var(--gutter); bottom: 6vh; z-index: 1;
    font-size: clamp(110px, 22vw, 360px);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.01em;
    margin-left: -0.03em;
    color: #fff;
  }
  .hero-cta { position: absolute; right: var(--gutter); bottom: 5vh; z-index: 1; }

  /* ---------- Fields ---------- */
  .fields {
    --fields-bg:
      radial-gradient(90% 60% at 85% 10%, rgba(71, 55, 255, 0.05), transparent 60%),
      linear-gradient(180deg, #f5f5f7 0%, #ececf0 100%);
    position: relative; z-index: 1;
    height: 220vh;
    background: var(--fields-bg);
    /* Lift the curtain off the hero. */
    box-shadow: 0 -24px 48px rgba(7, 6, 26, 0.28);
  }
  /* The stage carries its own background so the blended words have something to invert against. */
  .f-stage {
    position: sticky; top: 0; height: 100svh; overflow: hidden;
    display: grid; align-items: center;
    background: var(--fields-bg);
    isolation: isolate;
  }

  .collage {
    position: absolute; left: 0; right: 0; top: 0;
    height: 62vw;
    will-change: transform;
  }
  .tile {
    position: absolute;
    left: var(--dx); top: var(--dy); width: var(--dw);
    overflow: hidden;
    box-shadow: 0 18px 40px -18px rgba(32, 32, 48, 0.35);
  }
  .tile img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* White + difference: dark on the paper, inverted wherever a photo sits underneath. */
  .f-list {
    position: relative; z-index: 2;
    display: grid; gap: 2vh;
    color: #fff;
    mix-blend-mode: difference;
  }
  .f-word { display: inline-flex; align-items: flex-start; gap: 16px; opacity: 0.18; }
  .f-word .display {
    font-size: clamp(64px, 11vw, 180px);
    font-weight: 800;
    line-height: 1.12; /* room for stacked Vietnamese diacritics (Ồ, Ạ) */
    text-transform: uppercase;
  }
  .f-num { font-family: var(--mono); font-size: clamp(14px, 1.4vw, 20px); padding-top: 1.2em; }

  /* ---------- Selected ---------- */
  .selected {
    position: relative; z-index: 1;
    padding-block: 12vh 16vh;
    background:
      radial-gradient(60% 40% at 0% 100%, rgba(247, 92, 3, 0.04), transparent 70%),
      linear-gradient(180deg, #ececf0 0%, #f4f4f6 30%, #eeeef2 100%);
  }
  .sel-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 10vh; }
  .sel-head h2 { font-size: clamp(72px, 12vw, 200px); font-weight: 800; }

  .cases { display: grid; gap: 14vh; list-style: none; padding: 0; }
  .case-link { display: grid; gap: 24px; }
  .case-media {
    /* Keep the artwork's own proportions; cap tall pieces at 85vh. */
    aspect-ratio: var(--r);
    width: min(100%, calc(85vh * var(--r)));
    box-shadow: 0 30px 60px -30px rgba(32, 32, 48, 0.45);
  }
  .case-media img { display: block; width: 100%; height: 100%; }
  .case-info { display: grid; align-content: start; gap: 16px; }
  .case-num { font-size: clamp(56px, 7vw, 112px); font-weight: 800; color: var(--blue); line-height: 0.8; }
  .case-title { font-size: clamp(36px, 4vw, 64px); font-weight: 700; line-height: 0.95; }
  .case-meta { display: grid; gap: 6px; border-top: 1px solid var(--line); padding-top: 14px; }
  .case-meta div { display: grid; grid-template-columns: 64px 1fr; }
  .case-meta dt { color: var(--stone); }
  .case-meta dd { margin: 0; color: var(--ink); }
  .case-cta {
    justify-self: start;
    font-size: 13px; font-weight: 500; letter-spacing: 0.08em;
    color: var(--orange); border-bottom: 1px solid var(--orange);
  }
  .case-link:hover .case-title { color: var(--blue); }

  .all { margin-top: 12vh; }

  @media (min-width: 1024px) {
    .case-link { grid-template-columns: 7fr 4fr; gap: 5vw; align-items: start; }
    .case:nth-child(even) .case-link { grid-template-columns: 4fr 7fr; }
    .case:nth-child(even) .case-media { order: 2; justify-self: end; }
  }
  @media (max-width: 767px) {
    .hero-photo {
      inset: 0; width: 100%; aspect-ratio: auto;
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 45%);
              mask-image: linear-gradient(to top, transparent 0%, #000 45%);
    }
    .hero-cta { left: var(--gutter); right: auto; }
    .collage { height: 264vw; }
    .tile { left: var(--mx); top: var(--my); width: var(--mw); }
    .hero-cta { bottom: calc(6vh + 22vw + 16px); }
  }
</style>

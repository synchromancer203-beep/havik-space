---
// Home, as frames (scripts/frames.ts): hero → the three fields → one frame per featured work → footer.
// Riso one-ink print only on the hero; everything else keeps its real colours.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ink from '../components/Ink.astro';
import Frame from '../components/Frame.astro';
import chanDung from '../assets/personal/chan-dung.webp';
import liveNov from '../assets/personal/live-novation.jpg';
import musicHero from '../assets/personal/music-hero.jpg';
import musicLive from '../assets/personal/music-live.jpg';
import hero from '../assets/home/hero-portrait.jpg';
import wc from '../assets/work/warcross.webp';
import nob from '../assets/work/nob-network.jpg';
import open from '../assets/work/open.webp';
import cm05 from '../assets/collage/cm-05.png';
import cm09 from '../assets/collage/cm-09.webp';
import cm11 from '../assets/collage/cm-11.webp';
import cm15 from '../assets/collage/cm-15.webp';
import mukang from '../assets/collage/mukang-02.jpg';
import open03 from '../assets/collage/open-03.webp';
import cmStage from '../assets/work/corrupted-moonlight.webp';
import mare from '../assets/work/mare-crisisium.webp';
import { getLang, useT, href } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const vi = lang === 'vi';

const fields = [
  { key: 'spec.music', path: '/specialties/music' },
  { key: 'spec.visual', path: '/specialties/visual' },
  { key: 'spec.marketing', path: '/specialties/marketing' },
] as const;

// Collage around the three fields, in three depths: b (back: small, blurred, faded), m (middle:
// softly blurred) and f (front: sharp, shadowed). Back and middle photos may pass under the
// words, which invert over them; front photos are placed clear of the words. Each depth moves at
// its own pace when the frame scrolls in or out, and some photos run off the screen edge.
// [left %, top %, width] for desktop (d) and mobile (m), null = not on that layout. The width is in
// vw, shrunk on screens shorter than the layout was drawn for (16:10 desktop, 390×844 phone).
type Tile = { src: ImageMetadata; z: 'b' | 'm' | 'f'; d: number[] | null; m: number[] | null };
const tiles: Tile[] = [
  { src: cm15,      z: 'b', d: [20, 6, 10],   m: [40, 31, 28] },
  { src: open03,    z: 'b', d: [64, 20, 11],  m: [58, 66, 30] },
  { src: mukang,    z: 'b', d: [34, 64, 15],  m: [-4, 50, 40] },
  { src: mare,      z: 'b', d: [93, 62, 9],   m: null },
  { src: cm11,      z: 'b', d: [66, 88, 12],  m: [-8, 26, 22] },
  { src: cmStage,   z: 'b', d: [-3, 70, 13],  m: null },
  { src: cm05,      z: 'm', d: [40, 30, 8],   m: [52, 50, 20] },
  { src: wc,        z: 'm', d: [29, 44, 9],   m: [30, 88, 22] },
  { src: musicHero, z: 'f', d: [55, 3, 15],   m: [38, 0, 38] },
  { src: chanDung,  z: 'f', d: [76, -4, 11],  m: [4, 2, 28] },
  { src: liveNov,   z: 'f', d: [86, 28, 16],  m: [12, 19, 36] },
  { src: open,      z: 'f', d: [60, 39, 15],  m: [78, 40, 32] },
  { src: cm09,      z: 'f', d: [53, 70, 10],  m: [80, 5, 22] },
  { src: nob,       z: 'f', d: [72, 66, 17],  m: [4, 70, 42] },
  { src: musicLive, z: 'f', d: [8, 88, 15],   m: [50, 76, 44] },
];
const pos = (k: 'd' | 'm', v: number[] | null) => (v ? `--${k}x:${v[0]}%;--${k}y:${v[1]}%;--${k}w:${v[2]};` : '');

// Featured work comes from the content collection (featured: true), in the order music → visual → marketing.
const catOrder = { music: 0, visual: 1, marketing: 2 };
const featured = (await getCollection('works', (w) => w.data.featured && !!w.data.cover))
  .sort((a, b) => catOrder[a.data.category] - catOrder[b.data.category] || a.data.order - b.data.order || b.data.sort - a.data.sort)
  .map((w) => ({
    id: w.id,
    img: w.data.cover!,
    title: w.data.title,
    kind: w.data.kind[lang],
    role: w.data.role[lang],
    year: w.data.year[lang],
    tab: w.data.category,
  }));
---
<Base>
  <!-- HERO: dark portrait plate (its blue is the backdrop; frames.ts crossfades it out). -->
  <Frame class="hero" inner="hero-in" flush theme="dark">
    <div class="hero-photo" data-depth>
      <div class="hero-photo-in">
        <Ink src={hero} alt="Havik" widths={[480, 800, 1080]} sizes="(min-width: 768px) 57vh, 100vw" loading="eager" contrast={1.7} />
      </div>
    </div>

    <h1 class="display hero-name" aria-label="Havik">
      <span class="line"><span>HAVIK</span></span>
    </h1>

    <a href={href(lang, '/media')} class="btn btn--signal hero-cta">{t('btn.viewWork')} <span aria-hidden="true">↗</span></a>
  </Frame>

  <!-- FIELDS: three words in a layered collage; the words invert over the photos that pass under them -->
  <Frame class="fields" inner="f-stage">
    <div class="collage" aria-hidden="true">
      {tiles.map((tl, i) => (
        <div
          class:list={['tile', `tile--${tl.z}`, { 'no-d': !tl.d, 'no-m': !tl.m }]}
          data-enter
          data-depth
          style={`${pos('d', tl.d)}${pos('m', tl.m)}--i:${i};aspect-ratio:${tl.src.width}/${tl.src.height}`}
        >
          <div class="tile-in"><Image src={tl.src} alt="" widths={tl.z === 'f' ? [400, 720] : [320]} sizes="(min-width: 768px) 20vw, 40vw" /></div>
        </div>
      ))}
    </div>
    <!-- The words twice, stacked: a paper-coloured copy under the photos gives the inverting copy on
         top a solid backdrop, so it stays dark (and inverted over photos) while the frame's own
         background fades in and out during a scroll. -->
    <div class="f-words">
      <ul class="container f-list f-under" aria-hidden="true" data-enter="rise-twin">
        {fields.map((f) => <li><span class="f-word"><span class="display line"><span>{t(f.key)}</span></span></span></li>)}
      </ul>
      <ul class="container f-list f-top" data-enter="rise">
        {fields.map((f) => (
          <li><a href={href(lang, f.path)} class="f-word"><span class="display line"><span>{t(f.key)}</span></span></a></li>
        ))}
      </ul>
    </div>
  </Frame>

  <!-- SELECTED WORK: one frame per featured piece -->
  {featured.map((f, i) => (
    <Frame class="case" inner="container case-in">
      <a href={href(lang, `/media?tab=${f.tab}&work=${f.id}`)} class="case-link">
        <div class="case-media" data-enter data-depth style={`--r:${f.img.width / f.img.height}`}>
          <Image src={f.img} alt={f.title} widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 56vw, 100vw" />
        </div>
        <div class="case-info">
          <span class="case-num display" data-enter>{String(i + 1).padStart(2, '0')}</span>
          <h2 class="case-title display" data-enter="rise"><span class="line"><span>{f.title}</span></span></h2>
          <dl class="case-meta meta" data-enter>
            <div><dt>Type</dt><dd>{f.kind}</dd></div>
            <div><dt>Role</dt><dd>{f.role}</dd></div>
            {f.year && <div><dt>Year</dt><dd>{f.year}</dd></div>}
          </dl>
          <span class="case-cta" data-enter>{t('card.view')}</span>
        </div>
      </a>
      {i === featured.length - 1 && (
        <a href={href(lang, '/media')} class="btn btn--signal all" data-enter>{t('btn.viewAll')} <span aria-hidden="true">↗</span></a>
      )}
    </Frame>
  ))}
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    --plate: #4334f4; /* Vivid Blue after the paper multiply in Ink, so the print melts into it */
    --frame-bg: radial-gradient(70% 90% at 70% 40%, #4b3dff 0%, var(--plate) 70%);
    color: var(--paper);
  }
  .hero :global(.hero-in) { position: relative; overflow: hidden; }
  .hero-photo {
    position: absolute; top: 0; bottom: 0; right: 8vw;
    aspect-ratio: 9 / 16;
    transform-origin: 50% 40%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 85%, transparent 100%), linear-gradient(to top, transparent 0%, #000 30%);
    -webkit-mask-composite: source-in;
            mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 85%, transparent 100%), linear-gradient(to top, transparent 0%, #000 30%);
            mask-composite: intersect;
  }
  .hero-photo-in, .hero-photo :global(.ink) { width: 100%; height: 100%; }

  .hero-name {
    position: absolute; left: var(--gutter); bottom: 6vh; z-index: 1;
    font-size: clamp(110px, min(22vw, 44vh), 360px);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.01em;
    margin-left: -0.03em;
    color: #fff;
  }
  .hero-cta { position: absolute; right: var(--gutter); bottom: 5vh; z-index: 1; }

  /* Entrance (CSS, not GSAP: it shouldn't wait for JS) */
  .hero-photo-in { animation: hero-photo 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) both; }
  .hero-name .line > span { animation: hero-rise 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; }
  .hero-cta { animation: hero-cta 0.8s cubic-bezier(0.215, 0.61, 0.355, 1) 0.9s both; }
  @keyframes hero-photo { from { opacity: 0; transform: scale(1.05); } }
  @keyframes hero-rise { from { transform: translateY(105%); } }
  @keyframes hero-cta { from { opacity: 0; transform: translateY(16px); } }

  /* ---------- Fields ---------- */
  .fields {
    --frame-bg:
      radial-gradient(90% 60% at 85% 10%, rgba(71, 55, 255, 0.05), transparent 60%),
      linear-gradient(180deg, #f5f5f7 0%, #ececf0 100%);
  }
  /* The stage holds its own background so the blended words have something to invert against. */
  /* In the paged layout it stays put and fades with the backdrop (--fy, --bgo: frames.ts), so it
     never reads as a sliding sheet. */
  /* overflow: visible so the frame (the viewport), not the moving stage, clips that background. */
  .fields :global(.f-stage) { position: relative; justify-content: safe center; isolation: isolate; overflow: visible; }
  .fields :global(.f-stage)::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--frame-bg); opacity: var(--bgo, 1);
    translate: 0 calc(var(--fy, 0) * -1svh);
  }
  .collage { position: absolute; inset: var(--header-h) 0 0; z-index: 1; }
  .tile {
    --z: 0.26; /* how far ahead of the text this depth runs while the frame scrolls (svh per svh) */
    position: absolute;
    left: var(--dx); top: var(--dy); width: min(calc(var(--dw) * 1vw), calc(var(--dw) * 1.6svh));
  }
  html:global(.paged) .collage .tile { translate: 0 calc(var(--fy, 0) * var(--z) * 1svh); }
  .tile--f { box-shadow: 0 24px 48px -20px rgba(32, 32, 48, 0.45); }
  /* Fades go on the inner box: the entrance animates the tile's own opacity. */
  .tile--m { --z: 0.14; }
  .tile--m .tile-in { opacity: 0.9; }
  .tile--b { --z: 0.05; }
  .tile--b .tile-in { opacity: 0.7; }
  .no-d { display: none; }
  /* A slow drift keeps the collage alive while it is on screen; the back drifts least. */
  .tile-in { height: 100%; overflow: hidden; will-change: transform; animation: drift 9s ease-in-out calc(var(--i) * -1.3s) infinite alternate; }
  .tile--m .tile-in { animation-duration: 12s; }
  .tile--b .tile-in { animation-duration: 15s; }
  .tile-in :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* The blur sits on the image, inside the drifting box, so it is drawn once and only moved. */
  .tile--m :global(img) { filter: blur(1.5px) saturate(0.9); }
  .tile--b :global(img) { filter: blur(5px) saturate(0.7); transform: scale(1.06); }
  @keyframes drift { from { transform: translateY(-10px); } to { transform: translateY(10px); } }

  /* The two copies of the words share one grid cell. Under: paper-coloured, below the photos.
     Top: white + difference, above everything: dark on the paper, inverted over any photo. */
  .f-words { display: grid; }
  .f-list { grid-area: 1 / 1; display: grid; gap: 1vh; position: relative; }
  .f-under { z-index: 0; color: #f0f0f3; }
  .f-top { z-index: 2; color: #fff; mix-blend-mode: difference; }
  .f-word { display: inline-flex; }
  .f-word .display {
    font-size: clamp(64px, min(10vw, 18vh), 170px);
    font-weight: 800;
    line-height: 1.12; /* room for stacked Vietnamese diacritics (Ồ, Ạ) */
    text-transform: uppercase;
  }

  /* ---------- Selected: one frame per work ---------- */
  .case {
    --frame-bg:
      radial-gradient(60% 40% at 0% 100%, rgba(247, 92, 3, 0.04), transparent 70%),
      linear-gradient(180deg, #ececf0 0%, #f4f4f6 40%, #eeeef2 100%);
  }
  .case :global(.case-in) { justify-content: safe center; gap: 4vh; padding-bottom: 5vh; }
  .case-link { display: grid; gap: 20px; align-items: center; }
  .case-media {
    /* Keep the artwork's own proportions, sized to fit the frame. */
    aspect-ratio: var(--r);
    width: min(100%, calc(44svh * var(--r)));
    box-shadow: 0 30px 60px -30px rgba(32, 32, 48, 0.45);
  }
  .case-media :global(img) { display: block; width: 100%; height: 100%; }
  .case-info { display: grid; align-content: start; gap: 14px; }
  .case-num { font-size: clamp(48px, 7vw, 112px); font-weight: 800; color: var(--blue); line-height: 0.8; }
  .case-title { font-size: clamp(34px, 4vw, 64px); font-weight: 700; line-height: 0.95; }
  .case-meta { display: grid; gap: 6px; border-top: 1px solid var(--line); padding-top: 14px; }
  .case-meta div { display: grid; grid-template-columns: 64px 1fr; }
  .case-meta dt { color: var(--stone); }
  .case-meta dd { margin: 0; color: var(--ink); }
  .case-cta {
    justify-self: start;
    font-size: 13px; font-weight: 500; letter-spacing: 0.08em;
    color: var(--orange); border-bottom: 1px solid var(--orange);
  }
  .case-link:hover .case-title { color: var(--blue); }
  .all { align-self: flex-start; }

  @media (min-width: 1024px) {
    .case-link { grid-template-columns: 7fr 4fr; gap: 5vw; }
    .case-media { width: min(100%, calc(68svh * var(--r))); }
    .case:nth-child(even) .case-link { grid-template-columns: 4fr 7fr; }
    .case:nth-child(even) .case-media { order: 2; justify-self: end; }
  }
  @media (max-width: 767px) {
    .hero-photo {
      inset: 0; width: 100%; aspect-ratio: auto;
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 45%);
              mask-image: linear-gradient(to top, transparent 0%, #000 45%);
    }
    .hero-cta { left: var(--gutter); right: auto; bottom: calc(6vh + 22vw + 16px); }
    .tile { left: var(--mx); top: var(--my); width: min(calc(var(--mw) * 1vw), calc(var(--mw) * 0.462svh)); }
    .no-d { display: block; }
    .no-m { display: none; }
    .f-word .display { font-size: clamp(48px, min(16.5vw, 8.5svh), 72px); }
  }
</style>

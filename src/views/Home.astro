---
// Home. Visual system: one-ink print (ref hermes-agent). Motion: scroll-driven only (ref marcuslorenzet).
import Base from '../layouts/Base.astro';
import Ink from '../components/Ink.astro';
import hero from '../assets/home/hero.jpg';
import cm from '../assets/work/corrupted-moonlight.webp';
import bh from '../assets/work/beach-heaven.webp';
import wc from '../assets/work/warcross.webp';
import nob from '../assets/work/nob-network.jpg';
import nn from '../assets/work/noise-night.webp';
import open from '../assets/work/open.webp';
import mare from '../assets/work/mare-crisisium.webp';
import { getLang, useT, href } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const vi = lang === 'vi';

const tags = [
  { key: 'spec.music', path: '/specialties/music' },
  { key: 'spec.visual', path: '/specialties/visual' },
  { key: 'spec.marketing', path: '/specialties/marketing' },
] as const;

// Facts, not slogans. Words wrapped in * are highlighted.
const statement = vi
  ? 'Làm *synthwave* từ 2019. Vẽ *poster* cho những đêm noise. Xây hệ thống *marketing* cho NÓB Network và iMind.'
  : 'Making *synthwave* since 2019. Drawing *posters* for noise nights. Building *marketing* systems for NÓB Network and iMind.';
const words = statement.split(' ').map((w) => ({ text: w.replaceAll('*', ''), hl: w.includes('*') }));

// Thumbnails that fly past the statement: [image, left %, width vw, speed, start offset vh]
const flyers = [
  { src: nn, x: 4, w: 16, speed: 1.25, at: 30 },
  { src: open, x: 74, w: 20, speed: 0.9, at: 10 },
  { src: mare, x: 62, w: 13, speed: 1.6, at: 70 },
  { src: wc, x: 16, w: 12, speed: 1.05, at: 95 },
  { src: bh, x: 82, w: 11, speed: 1.4, at: 120 },
];

// Interim featured list; Phase 2 will read this from the content collection.
const featured = [
  { img: cm, title: 'Corrupted Moonlight', kind: vi ? 'Ban nhạc synthwave' : 'Synthwave band', role: 'Founder · Producer', year: '2019—', tab: 'music', pos: '50% 35%' },
  { img: bh, title: 'Beach/heaven', kind: 'Album', role: vi ? 'Mix · Master · Sound design' : 'Mix · Master · Sound design', year: '2022', tab: 'music', pos: '50% 50%' },
  { img: wc, title: 'Warcross', kind: vi ? 'Bìa sách & minh họa' : 'Book cover & illustration', role: 'Design', year: '2022', tab: 'visual', pos: '50% 40%' },
  { img: nob, title: 'NÓB Network', kind: vi ? 'Mạng lưới nghệ sĩ Live Electronic' : 'Live electronic artist network', role: 'Founder · CEO', year: '2026', tab: 'marketing', pos: '50% 50%' },
];
---
<Base flush>
  <!-- HERO: riso-printed portrait on paper; the next section slides over it like a curtain -->
  <section class="hero">
    <div class="hero-photo">
      <Ink src={hero} widths={[960, 1440, 2048]} sizes="(min-width: 1024px) 64vw, 100vw" loading="eager" position="50% 30%" contrast={1.5} />
    </div>

    <ul class="hero-tags">
      {tags.map((tg, i) => (
        <li><a href={href(lang, tg.path)}><span class="meta">/0{i + 1}</span> {t(tg.key)}</a></li>
      ))}
    </ul>

    <h1 class="display hero-name" aria-label="Havik">
      <span class="line"><span>HAVIK</span></span>
    </h1>
  </section>

  <!-- STATEMENT: words light up as you scroll; covers fly past -->
  <section class="statement">
    <div class="st-stage">
      <div class="flyers" aria-hidden="true">
        {flyers.map((f) => (
          <div class="flyer" style={`left:${f.x}%;width:${f.w}vw;top:${f.at}vh`} data-speed={f.speed}>
            <Ink src={f.src} widths={[320, 640]} sizes={`${f.w}vw`} />
          </div>
        ))}
      </div>
      <div class="container st-inner">
        <p class="meta">[ /01 {vi ? 'Việc tôi làm' : 'What I do'} ]</p>
        <p class="st-text">
          {words.map((w) => <span class:list={['w', { hl: w.hl }]}>{w.text} </span>)}
        </p>
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="selected">
    <div class="container">
      <header class="sel-head">
        <h2 class="display"><span class="line"><span>{vi ? 'Nổi bật.' : 'Selected.'}</span></span></h2>
        <p class="meta">[ /02 {t('nav.media')} ]</p>
      </header>

      <ol class="cases">
        {featured.map((f, i) => (
          <li class="case">
            <a href={href(lang, `/media?tab=${f.tab}`)} class="case-link">
              <div class="case-media">
                <div class="case-img"><Ink src={f.img} widths={[640, 1080, 1440]} sizes="(min-width: 1024px) 56vw, 100vw" position={f.pos} /></div>
              </div>
              <div class="case-info">
                <span class="case-num display">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="case-title display">{f.title}</h3>
                <dl class="case-meta meta">
                  <div><dt>Type</dt><dd>{f.kind}</dd></div>
                  <div><dt>Role</dt><dd>{f.role}</dd></div>
                  <div><dt>Year</dt><dd>{f.year}</dd></div>
                </dl>
                <span class="case-cta">{t('card.view')}</span>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <a href={href(lang, '/media')} class="btn btn--blue all">{t('btn.viewAll')} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<script>
  import { gsap } from '../scripts/smooth';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Load: hero name rises out of its mask, tags follow.
  gsap.from('.hero-name .line > span', { yPercent: 105, duration: 1.4, ease: 'expo.out', delay: 0.15 });
  gsap.from('.hero-tags li', { y: 16, opacity: 0, duration: 0.8, ease: 'power3.out', stagger: 0.08, delay: 0.6 });
  gsap.from('.hero-photo', { opacity: 0, scale: 1.06, duration: 1.6, ease: 'power2.out' });

  if (!reduce) {
    // Hero recedes while the statement slides over it.
    gsap.timeline({ scrollTrigger: { trigger: '.statement', start: 'top bottom', end: 'top top', scrub: true } })
      .to('.hero-photo', { scale: 1.12, yPercent: 8, ease: 'none' }, 0)
      .to('.hero-name', { yPercent: -40, opacity: 0.25, ease: 'none' }, 0)
      .to('.hero-tags', { opacity: 0, ease: 'none' }, 0);

    // Statement: words fill from faint to ink, in reading order.
    gsap.to('.st-text .w', {
      opacity: 1,
      stagger: 0.1,
      ease: 'none',
      scrollTrigger: { trigger: '.statement', start: 'top 20%', end: 'bottom bottom', scrub: true },
    });

    // Covers drift upward through the frame at their own speeds.
    document.querySelectorAll<HTMLElement>('.flyer').forEach((el) => {
      const s = Number(el.dataset.speed);
      gsap.fromTo(el, { y: '40vh' }, {
        y: `${-160 * s}vh`,
        ease: 'none',
        scrollTrigger: { trigger: '.statement', start: 'top bottom', end: 'bottom top', scrub: true },
      });
    });

    // Section title rises from its mask.
    gsap.from('.sel-head .line > span', {
      yPercent: 105, duration: 1.2, ease: 'expo.out',
      scrollTrigger: { trigger: '.sel-head', start: 'top 80%' },
    });

    // Each case: image opens from a narrow slit, content inside drifts (parallax).
    document.querySelectorAll<HTMLElement>('.case').forEach((c) => {
      const media = c.querySelector('.case-media')!;
      const img = c.querySelector('.case-img')!;
      gsap.fromTo(media, { clipPath: 'inset(18% 12% 18% 12%)' }, {
        clipPath: 'inset(0% 0% 0% 0%)', ease: 'none',
        scrollTrigger: { trigger: c, start: 'top 95%', end: 'top 35%', scrub: true },
      });
      gsap.fromTo(img, { yPercent: -8 }, {
        yPercent: 8, ease: 'none',
        scrollTrigger: { trigger: c, start: 'top bottom', end: 'bottom top', scrub: true },
      });
      gsap.from(c.querySelectorAll('.case-info > *'), {
        y: 40, opacity: 0, stagger: 0.08, ease: 'none',
        scrollTrigger: { trigger: c, start: 'top 80%', end: 'top 40%', scrub: true },
      });
    });
  } else {
    gsap.set('.st-text .w', { opacity: 1 });
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    z-index: 0;
    background: var(--paper-2);
  }
  .hero-photo { position: absolute; inset: 0 0 0 auto; width: 72%; transform-origin: 70% 40%; }
  .hero-photo :global(.ink) { height: 100%; }
  /* Dissolve the print (halftone included) into the paper on the left and bottom. */
  .hero-photo {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 42%), linear-gradient(to top, transparent 0%, #000 40%);
    -webkit-mask-composite: source-in;
            mask-image: linear-gradient(to right, transparent 0%, #000 42%), linear-gradient(to top, transparent 0%, #000 40%);
            mask-composite: intersect;
  }

  .hero-tags {
    position: absolute; left: var(--gutter); top: calc(var(--header-h) + 32px);
    display: grid; gap: 6px; z-index: 1;
  }
  .hero-tags a { font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; }
  .hero-tags a:hover { color: var(--blue); }

  .hero-name {
    position: absolute; left: var(--gutter); bottom: 2vh; z-index: 1;
    font-size: clamp(110px, 24vw, 380px);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.02em;
    margin-left: -0.03em;
    color: var(--ink);
  }

  /* ---------- Statement ---------- */
  .statement {
    position: relative; z-index: 1;
    background: var(--paper-2);
    height: 260vh;
  }
  .st-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; display: grid; align-items: center; }
  .st-inner { position: relative; z-index: 2; pointer-events: none; }
  .st-text {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(40px, 6.4vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    max-width: 14ch;
    margin-top: 24px;
  }
  .w { opacity: 0.14; }
  .w.hl { color: var(--blue); }

  .flyers { position: absolute; inset: 0; z-index: 1; }
  .flyer { position: absolute; aspect-ratio: 4 / 5; will-change: transform; }
  .flyer :global(.ink) { height: 100%; }

  /* ---------- Selected ---------- */
  .selected { position: relative; z-index: 1; background: var(--paper-2); padding-block: 12vh 16vh; }
  .sel-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 10vh; }
  .sel-head h2 { font-size: clamp(72px, 13vw, 220px); font-weight: 300; }

  .cases { display: grid; gap: 14vh; list-style: none; padding: 0; }
  .case-link { display: grid; gap: 24px; }
  .case-media { overflow: hidden; aspect-ratio: 16 / 10; }
  .case-img { height: 116%; margin-top: -8%; }
  .case-img :global(.ink) { height: 100%; }
  .case-info { display: grid; align-content: start; gap: 16px; }
  .case-num { font-size: clamp(56px, 7vw, 112px); color: var(--blue); line-height: 0.8; }
  .case-title { font-size: clamp(36px, 4vw, 64px); font-weight: 400; line-height: 0.95; }
  .case-meta { display: grid; gap: 6px; border-top: 1px solid var(--line); padding-top: 14px; }
  .case-meta div { display: grid; grid-template-columns: 64px 1fr; }
  .case-meta dt { color: var(--stone); }
  .case-meta dd { margin: 0; color: var(--ink); }
  .case-cta { font-size: 13px; letter-spacing: 0.08em; color: var(--blue); }
  .case-link:hover .case-title { color: var(--blue); }

  .all { margin-top: 12vh; }

  @media (min-width: 1024px) {
    .case-link { grid-template-columns: 7fr 4fr; gap: 5vw; align-items: start; }
    .case:nth-child(even) .case-link { grid-template-columns: 4fr 7fr; }
    .case:nth-child(even) .case-media { order: 2; }
  }
  @media (max-width: 767px) {
    .hero-photo {
      width: 100%;
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 55%);
              mask-image: linear-gradient(to top, transparent 0%, #000 55%);
    }
    .flyer { width: 34vw !important; }
  }
</style>

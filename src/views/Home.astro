---
// Phase 1: hero only. Remaining sections arrive in Phase 3.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/home/hero.jpg';
import { getLang, useT, href } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const tags = [
  { key: 'spec.music', path: '/specialties/music' },
  { key: 'spec.visual', path: '/specialties/visual' },
  { key: 'spec.marketing', path: '/specialties/marketing' },
] as const;
---
<Base>
  <section class="hero">
    <div class="layer photo" data-depth="0.25">
      <Image src={hero} alt="" widths={[960, 1440, 2048]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="layer glow" aria-hidden="true"></div>

    <div class="container content" data-depth="-0.08">
      <h1 class="display name">HAVIK<span>.</span></h1>
      <ul class="tags">
        {tags.map((tg, i) => (
          <li><a href={href(lang, tg.path)}><span class="meta">/0{i + 1}</span>{t(tg.key)}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  // Light scroll parallax: layers drift at different speeds for depth.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = [...document.querySelectorAll<HTMLElement>('[data-depth]')];
    let ticking = false;
    const update = () => {
      const y = scrollY;
      layers.forEach((l) => (l.style.transform = `translate3d(0, ${y * Number(l.dataset.depth)}px, 0)`));
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .layer { position: absolute; inset: 0; z-index: -1; }
  /* Static fade at the bottom so the drifting photo never shows a hard edge. */
  .hero::after {
    content: ''; position: absolute; inset: auto 0 0; height: 35%; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--paper-2) 85%);
  }

  /* Photo bleeds edge to edge and dissolves into the paper toward the bottom and left. */
  .photo { will-change: transform; }
  .photo img {
    width: 100%; height: 115%; object-fit: cover; object-position: 50% 30%;
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 92%);
            mask-image: linear-gradient(to bottom, #000 45%, transparent 92%);
  }
  /* Soft blue halo sitting between photo and type. */
  .glow {
    background:
      radial-gradient(60% 50% at 70% 40%, rgba(71, 55, 255, 0.28), transparent 70%),
      linear-gradient(to right, rgba(242, 242, 244, 0.55), transparent 45%);
    mix-blend-mode: multiply;
  }

  .content { position: relative; padding-block: 48px 40px; will-change: transform; }
  .name {
    font-size: clamp(56px, 13vw, 200px);
    margin-left: -0.04em;
    color: var(--ink);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .name span { color: var(--blue); }

  .tags { display: flex; flex-wrap: wrap; gap: 4px 28px; margin-top: 20px; }
  .tags a {
    display: inline-flex; align-items: baseline; gap: 8px;
    font-size: 14px; text-transform: uppercase; letter-spacing: 0.08em;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .tags a:hover { color: var(--blue); border-color: var(--blue); }
</style>

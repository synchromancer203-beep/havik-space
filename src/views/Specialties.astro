---
// /specialties, as frames: title + index → one frame per field → the "combined" block → footer.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ink from '../components/Ink.astro';
import Frame from '../components/Frame.astro';
import { specialties, combined } from '../data/specialties';
import { getLang, useT, href } from '../i18n/utils';
import musicHero from '../assets/personal/music-hero.jpg';
import wcCover from '../content/works/warcross/cover.webp';
import nobCover from '../content/works/nob-network/cover.jpg';
import cassette from '../assets/collage/cm-05.png';

const lang = getLang(Astro.url);
const t = useT(lang);
const vi = lang === 'vi';
const img = { music: musicHero, visual: wcCover, marketing: nobCover };
---
<Base title={t('nav.specialties')}>
  <Frame class="head" inner="container head-in">
    <h1 class="display" data-enter="rise"><span class="line"><span>{vi ? 'Chuyên môn.' : 'Specialties.'}</span></span></h1>
    <ol class="index">
      {specialties.map((sp, i) => (
        <li data-enter>
          <a href={href(lang, sp.path)}><span class="num">{i + 1}.</span><span class="display">{t(`spec.${sp.id}` as const)}</span><span class="idx-line">{sp.line[lang]}</span></a>
        </li>
      ))}
    </ol>
  </Frame>

  {specialties.map((sp, i) => (
    <Frame class="row" inner="container row-in">
      <a href={href(lang, sp.path)} class="row-link">
        <div class="row-media" data-enter>
          {sp.id === 'music'
            ? <Ink src={img[sp.id]} alt="" widths={[640, 1080]} sizes="(min-width: 1024px) 44vw, 90vw" contrast={1.5} />
            : <Image src={img[sp.id]} alt="" widths={[640, 1080]} sizes="(min-width: 1024px) 44vw, 90vw" />}
        </div>
        <div class="row-info">
          <span class="num" data-enter>{i + 1}.</span>
          <h2 class="display" data-enter="rise"><span class="line"><span>{t(`spec.${sp.id}` as const)}</span></span></h2>
          <p data-enter>{sp.line[lang]}</p>
          <ul class="chips" data-enter>{sp.skills.slice(0, 5).map((s) => <li>{s}</li>)}</ul>
          <span class="row-cta" data-enter>{t('btn.learnMore')} ↗</span>
        </div>
      </a>
    </Frame>
  ))}

  <Frame class="combined" inner="container combined-in">
    <div class="combined-media" data-enter>
      <Image src={cassette} alt="Corrupted Moonlight cassette" widths={[480, 800]} sizes="(min-width: 1024px) 30vw, 70vw" />
    </div>
    <div>
      <p class="meta" data-enter>{vi ? 'Kết hợp' : 'Combined'}</p>
      <p class="combined-text" data-enter>{combined[lang]}</p>
      <a href={href(lang, '/media?tab=music&work=corrupted-moonlight')} class="btn btn--signal" data-enter>Corrupted Moonlight ↗</a>
    </div>
  </Frame>
</Base>

<style>
  .head :global(.head-in) { justify-content: safe center; gap: 6vh; padding-bottom: 5vh; }
  .head h1 { font-size: clamp(64px, min(12vw, 20vh), 200px); font-weight: 800; }
  .index { list-style: none; padding: 0; border-top: 1px solid var(--ink); }
  .index a { display: grid; grid-template-columns: auto 1fr; align-items: baseline; column-gap: 0.6em; padding-block: 14px; border-bottom: 1px solid var(--line); }
  .index .display { font-size: clamp(32px, min(4.4vw, 7vh), 64px); font-weight: 700; text-transform: uppercase; line-height: 1; transition: color 0.3s; }
  .index .idx-line { grid-column: 2; color: var(--stone); }
  .index a:hover .display { color: var(--blue); }

  .row :global(.row-in) { justify-content: safe center; padding-bottom: 5vh; }
  .row-link { display: grid; gap: 24px; align-items: center; }
  .row-media { aspect-ratio: 4 / 3; width: min(100%, calc(40svh * 4 / 3)); overflow: hidden; box-shadow: 0 30px 60px -30px rgba(32, 32, 48, 0.45); }
  .row-media :global(img), .row-media :global(.ink) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .row-info { display: grid; gap: 14px; align-content: center; justify-items: start; }
  .row-info h2 { font-size: clamp(56px, min(8vw, 13vh), 128px); font-weight: 800; text-transform: uppercase; line-height: 0.9; transition: color 0.3s; }
  .row-link:hover h2 { color: var(--blue); }
  .num { font-family: var(--mono); color: #a9a9b3; font-size: 18px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; }
  .chips li { border: 1px solid var(--line); padding: 6px 10px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .row-cta { color: var(--orange); border-bottom: 1px solid var(--orange); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }

  .combined :global(.combined-in) { justify-content: safe center; gap: 32px; padding-bottom: 5vh; }
  .combined-media { width: min(100%, 420px, 36svh); box-shadow: 0 30px 60px -30px rgba(32, 32, 48, 0.45); }
  .combined-media :global(img) { display: block; width: 100%; height: auto; }
  .combined-text { font-family: var(--display); font-weight: 600; font-size: clamp(24px, 2.8vw, 42px); line-height: 1.15; margin: 16px 0 28px; max-width: 30ch; }

  @media (min-width: 1024px) {
    .row-link { grid-template-columns: 5fr 4fr; gap: 6vw; }
    .row-media { width: min(100%, calc(66svh * 4 / 3)); }
    .row:nth-child(odd) .row-media { order: 2; }
    .combined :global(.combined-in) { flex-direction: row; align-items: center; gap: 6vw; }
    .combined-media { width: min(30vw, 56svh); flex: none; }
  }
</style>

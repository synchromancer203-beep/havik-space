---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, useT, alternate, neutralPath } from '../i18n/utils';
import { languages, defaultLang, site, type Lang } from '../i18n/ui';
import { seo, ogSlug } from '../data/seo';
// Display face for headings (the home hero name is the largest paint): fetch it with the HTML.
import displayFont from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Let the first section run under the fixed header (used by full-bleed heroes). */
  flush?: boolean;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const path = neutralPath(Astro.url.pathname).replace(/(.)\/$/, '$1');
const page = seo[path];
const { title, description = page?.description[lang] ?? t('meta.description'), flush = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | Havik` : 'Havik';
const origin = Astro.site!.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(`/og/${lang}/${ogSlug(page ? path : '/')}.png`, origin).href;
const locale = (l: Lang) => (l === 'vi' ? 'vi_VN' : 'en_US');
// Structured data for the home page: who the site is about and where else they are.
const person = path === '/' && {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Havik',
  url: new URL(alternate(Astro.url, lang), origin).href,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Hanoi', addressCountry: 'VN' },
  knowsAbout: ['Electronic music', 'Graphic design', 'Web design', 'Marketing'],
  sameAs: site.social.map((s) => s.url),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(alternate(Astro.url, l), origin).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternate(Astro.url, defaultLang), origin).href} />
    <meta property="og:site_name" content="Havik" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={path === '/about' ? 'profile' : 'website'} />
    <meta property="og:locale" content={locale(lang)} />
    {(Object.keys(languages) as Lang[]).filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={locale(l)} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    {person && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    {site.cfBeacon && (
      // Cloudflare Web Analytics: cookieless page-view counts (token from the Cloudflare dashboard).
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfBeacon })} />
    )}
    <script is:inline>
      // Arrived through a page transition: paint under the paper layer (see scripts/transition.ts),
      // unless the browser runs a cross-document view transition, which crossfades from the old
      // page's last frame straight to this one. pagereveal fires just before the first render.
      try {
        var pt = +sessionStorage.getItem('pt');
        sessionStorage.removeItem('pt');
        if (Date.now() - pt < 5000 && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('pt-in');
      } catch (e) {}
      addEventListener('pagereveal', function (e) {
        window.__ptReveal = e.viewTransition ? 'vt' : 'plain';
        if (e.viewTransition) document.documentElement.classList.remove('pt-in');
        dispatchEvent(new Event('pt:reveal'));
      }, { once: true });
    </script>
    <script>import '../scripts/transition';</script>
  </head>
  <body>
    <div class="pt" aria-hidden="true"><canvas></canvas></div>
    <a href="#main" class="skip">{t('skip')}</a>
    <Header />
    <main id="main" class:list={{ flush }}>
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/smooth';</script>
  </body>
</html>

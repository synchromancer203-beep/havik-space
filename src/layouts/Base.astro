---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import { getLang, useT, alternate } from '../i18n/utils';
import { languages, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const { title, description = t('meta.description') } = Astro.props;
const fullTitle = title ? `${title} | Havik` : 'Havik';
const origin = Astro.site!.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(alternate(Astro.url, l), origin).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternate(Astro.url, defaultLang), origin).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <a href="#main" class="skip">{t('skip')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Dock />
    <script>import '../scripts/smooth';</script>
  </body>
</html>

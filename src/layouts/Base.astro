---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, useT, alternate } from '../i18n/utils';
import { languages, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Let the first section run under the fixed header (used by full-bleed heroes). */
  flush?: boolean;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const { title, description = t('meta.description'), flush = false } = Astro.props;
const fullTitle = title ? `${title} | Havik` : 'Havik';
const origin = Astro.site!.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(alternate(Astro.url, l), origin).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternate(Astro.url, defaultLang), origin).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Arrived through a page transition: paint mid-sweep (see scripts/transition.ts).
      try {
        var pt = +sessionStorage.getItem('pt');
        sessionStorage.removeItem('pt');
        if (Date.now() - pt < 5000 && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('pt-in');
      } catch (e) {}
    </script>
    <script>import '../scripts/transition';</script>
  </head>
  <body>
    <div class="pt" aria-hidden="true"><canvas></canvas></div>
    <script is:inline>
      // Riso sweep for page transitions: on a paper layer, a band of fine Vivid Blue grain
      // (white-noise stipple, sparse at its leading edge, dense at its core) travels from the
      // bottom edge to the top. Seeded, so both documents draw the same grain. Inline so a page
      // arriving through a transition paints the sweep's midpoint from its first frame.
      // Animated by scripts/transition.ts.
      (function () {
        var c = document.currentScript.previousElementSibling.firstElementChild;
        var BLUE = 0xffff3747; // ABGR #4737FF
        var H = 0.9; // band height, share of the viewport
        var ctx, img, buf, thr, lv, w, h;
        function build() {
          var cell = Math.max(2, Math.ceil(Math.sqrt((innerWidth * innerHeight) / 1e6)));
          w = Math.ceil(innerWidth / cell); h = Math.ceil(innerHeight / cell);
          c.width = w; c.height = h;
          ctx = c.getContext('2d'); img = ctx.createImageData(w, h); buf = new Uint32Array(img.data.buffer);
          thr = new Uint8Array(w * h); lv = new Uint16Array(h);
          var seed = 0x2f6b9a1d;
          for (var i = 0; i < thr.length; i++) { seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5; thr[i] = (seed >>> 0) >>> 24; }
        }
        // u: 0 at the band's top (leading) edge, 1 at its bottom edge.
        function density(u) {
          if (u <= 0 || u >= 1) return 0;
          return u < 0.8 ? Math.pow(u / 0.8, 1.8) : 1 - Math.pow((u - 0.8) / 0.2, 0.7);
        }
        // pos: 0 = band just below the screen, 0.5 = across the middle, 1 = gone off the top.
        function draw(pos) {
          if (!buf) build();
          var top = (1 - pos * (1 + H)) * h, bh = H * h;
          for (var y = 0; y < h; y++) lv[y] = density((y - top) / bh) * 256;
          for (var y = 0, i = 0; y < h; y++) {
            var l = lv[y];
            if (!l) { buf.fill(0, i, i + w); i += w; continue; }
            for (var x = 0; x < w; x++, i++) buf[i] = thr[i] < l ? BLUE : 0;
          }
          ctx.putImageData(img, 0, 0);
        }
        window.__pt = { build: build, draw: draw };
        if (document.documentElement.classList.contains('pt-in')) draw(0.5);
      })();
    </script>
    <a href="#main" class="skip">{t('skip')}</a>
    <Header />
    <main id="main" class:list={{ flush }}>
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/smooth';</script>
  </body>
</html>

---
import { getLang, useT, href, alternate, neutralPath, nav } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = useT(lang);
const current = neutralPath(Astro.url.pathname);

const isActive = (path: string) => {
  const p = path.split(/[?#]/)[0].replace(/\/$/, '') || '/';
  const c = current.replace(/\/$/, '') || '/';
  return p === '/' ? c === '/' : c === p || c.startsWith(`${p}/`);
};
---
<header class="header">
  <div class="bar container">
    <a href={href(lang, '/')} class="logo" aria-label="Havik">
      HAVIK<span>.</span>
    </a>

    <nav class="desktop" aria-label="Main">
      <ul class="menu">
        {nav.map((item, i) => (
          <li class:list={['item', { 'has-sub': item.children }]}>
            <a href={href(lang, item.path)} class:list={{ active: isActive(item.path) && item.path !== '#contact' }}>
              <span class="num">{i + 1}.</span>{t(item.key)}
            </a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => (
                  <li><a href={href(lang, c.path)}>{t(c.key)}<span aria-hidden="true">↗</span></a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <div class="lang" aria-label={t('lang.switch')}>
        {(Object.keys(languages) as Lang[]).map((l) => (
          <a
            href={alternate(Astro.url, l)}
            hreflang={l}
            lang={l}
            class:list={{ on: l === lang }}
            aria-current={l === lang ? 'true' : undefined}
          >{languages[l]}</a>
        ))}
      </div>
      <a href={href(lang, '#contact')} class="btn btn--signal cta">{t('cta')} <span aria-hidden="true">↗</span></a>
      <button class="burger" aria-expanded="false" aria-controls="mobile-menu" data-open={t('menu.open')} data-close={t('menu.close')}>
        <span class="sr-only">{t('menu.open')}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile" aria-label="Mobile" hidden>
    <ul class="container">
      {nav.map((item, i) => (
        <li>
          {item.children ? (
            <details>
              <summary><span class="num">{i + 1}.</span>{t(item.key)}<span class="plus" aria-hidden="true">+</span></summary>
              <ul>
                <li><a href={href(lang, item.path)}>{t(item.key)} ↗</a></li>
                {item.children.map((c) => <li><a href={href(lang, c.path)}>{t(c.key)} ↗</a></li>)}
              </ul>
            </details>
          ) : (
            <a href={href(lang, item.path)} class="row"><span class="num">{i + 1}.</span>{t(item.key)}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const label = btn.querySelector('.sr-only')!;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      label.textContent = open ? btn.dataset.close! : btn.dataset.open!;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && set(false));
  }

  // Header turns transparent/white while the section actually visible beneath it is dark.
  // (Hit-testing, not rects: a sticky hero stays "in place" under the next section.)
  const header = document.querySelector<HTMLElement>('.header')!;
  const probe = () => {
    const y = header.offsetHeight / 2;
    const under = document.elementsFromPoint(innerWidth / 2, y).find((el) => !header.contains(el));
    const dark = under?.closest('[data-theme]')?.getAttribute('data-theme') === 'dark';
    header.classList.toggle('on-blue', dark && menu?.hidden !== false);
  };
  let queued = false;
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { probe(); queued = false; }); } }, { passive: true });
  addEventListener('resize', probe);
  addEventListener('frames:update', probe); // paged layout (scripts/frames.ts): the page itself doesn't scroll
  addEventListener('frames:settle', probe);
  btn?.addEventListener('click', probe);
  probe();
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    transition: background 0.4s, color 0.4s, border-color 0.4s;
  }
  .header.on-blue { background: transparent; color: var(--paper); border-color: transparent; }
  .header.on-blue .logo span { color: var(--orange); }
  .header.on-blue .num { color: rgba(255, 255, 255, 0.55); }
  .header.on-blue .menu, .header.on-blue .item { border-color: transparent; }
  .header.on-blue .item > a:hover { background: rgba(255, 255, 255, 0.12); }
  .header.on-blue .lang, .header.on-blue .lang a + a, .header.on-blue .burger { border-color: var(--paper); }
  .header.on-blue .lang a.on { background: var(--paper); color: var(--ink); }
  .header.on-blue .sub { color: var(--ink); } /* dropdown keeps its paper panel, so keep dark text */
  .header.on-blue .lang a:not(.on):hover { background: rgba(255, 255, 255, 0.12); }
  .header.on-blue .burger i { background: var(--paper); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: var(--header-h); }

  .logo { font-family: var(--display); font-weight: 800; font-size: 28px; letter-spacing: 0.02em; line-height: 1; }
  .logo span { color: var(--blue); }

  /* Menu index: same size as the label, light grey. */
  .num { font-size: inherit; color: #a9a9b3; margin-right: 0.4em; }
  @media (min-width: 1280px) { .item > a { padding: 0 18px; } }

  /* Desktop menu: cells divided by lines */
  .desktop { display: none; align-self: stretch; }
  .menu { display: flex; height: 100%; border-left: 1px solid var(--line); }
  .item { position: relative; border-right: 1px solid var(--line); }
  .item > a {
    display: flex; align-items: center; height: 100%; padding: 0 14px;
    font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap;
    transition: background 0.2s;
  }
  .item > a:hover, .item:focus-within > a { background: var(--paper-2); }
  .item > a.active { box-shadow: inset 0 -3px 0 var(--blue); }
  .has-sub > a::after { content: '▾'; font-size: 10px; margin-left: 6px; color: var(--stone); }

  .sub {
    position: absolute; top: 100%; left: -1px; min-width: 240px;
    background: var(--paper); border: 1px solid var(--ink);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 0.2s, transform 0.2s var(--ease-out), visibility 0.2s;
  }
  .item:hover .sub, .item:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a {
    display: flex; justify-content: space-between; padding: 12px 16px;
    font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .sub li + li a { border-top: 1px solid var(--line); }
  .sub a:hover { background: var(--blue); color: var(--paper); }

  .tools { display: flex; align-items: center; gap: 12px; }
  .lang { display: flex; border: 1px solid var(--ink); }
  .lang a { padding: 0 10px; line-height: 30px; font-size: 12px; letter-spacing: 0.06em; }
  .lang a + a { border-left: 1px solid var(--ink); }
  .lang a.on { background: var(--ink); color: var(--paper); }
  .lang a:not(.on):hover { background: var(--paper-2); }

  .cta { display: none; }

  .burger { position: relative; width: 44px; height: 44px; border: 1px solid var(--ink); }
  .burger i { position: absolute; left: 12px; right: 12px; height: 2px; background: var(--ink); transition: transform 0.3s var(--ease-out); }
  .burger i:first-of-type { top: 16px; }
  .burger i:last-of-type { bottom: 16px; }
  .burger[aria-expanded='true'] i:first-of-type { transform: translateY(4px) rotate(45deg); }
  .burger[aria-expanded='true'] i:last-of-type { transform: translateY(-4px) rotate(-45deg); }

  /* Mobile menu with accordion submenus */
  .mobile {
    position: fixed; inset: var(--header-h) 0 0; z-index: 49;
    background: var(--paper); overflow-y: auto; border-top: 1px solid var(--ink);
  }
  .mobile > ul > li { border-bottom: 1px solid var(--line); }
  .mobile .row, .mobile summary {
    display: flex; align-items: center; padding: 18px 0;
    font-family: var(--display); font-weight: 500; font-size: 36px; text-transform: uppercase; letter-spacing: -0.02em;
    cursor: pointer; list-style: none;
  }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile .plus { margin-left: auto; font-family: var(--mono); font-weight: 400; transition: transform 0.3s; }
  .mobile details[open] .plus { transform: rotate(45deg); }
  .mobile details ul { padding: 0 0 16px 28px; }
  .mobile details a { display: block; padding: 8px 0; text-transform: uppercase; font-size: 14px; letter-spacing: 0.04em; }

  @media (min-width: 640px) { .cta { display: inline-flex; } }
  @media (min-width: 1024px) {
    .desktop { display: block; }
    .burger { display: none; }
  }
</style>

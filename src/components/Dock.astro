---
// Floating dock nav (motion-guide.md §8). Appears once the page is scrolled past the first screen.
import { getLang, useT, href } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const links = [
  { key: 'nav.specialties', path: '/specialties' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.media', path: '/media' },
] as const;
---
<nav class="dock" aria-label="Quick">
  {links.map((l) => <a href={href(lang, l.path)}>{t(l.key)}</a>)}
  <a href={href(lang, '#contact')} class="talk"><i class="pixel"></i>{t('cta')}</a>
</nav>

<script>
  // The header is fixed (never scrolls away), so show the dock once past the first screen.
  const dock = document.querySelector<HTMLElement>('.dock');
  if (dock) {
    let queued = false;
    const update = () => { dock.classList.toggle('show', scrollY > innerHeight * 0.9); queued = false; };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

<style>
  .dock {
    position: fixed; left: 50%; bottom: 20px; z-index: 40;
    display: none;
    background: var(--paper); border: 1px solid var(--ink);
    transform: translate(-50%, calc(100% + 40px));
    transition: transform 0.5s var(--ease-out);
  }
  .dock.show { transform: translate(-50%, 0); }
  .dock a {
    display: flex; align-items: center; gap: 8px; padding: 0 18px; height: 44px;
    font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
  }
  .dock a + a { border-left: 1px solid var(--ink); }
  .dock a:hover { background: var(--paper-2); }
  .dock .talk { background: var(--orange); color: var(--paper); }
  .dock .talk .pixel { background: var(--paper); }
  .dock .talk:hover { background: var(--ink); }
  .x { position: absolute; width: 9px; height: 9px; }
  .x::before, .x::after { content: ''; position: absolute; background: var(--ink); }
  .x::before { left: 4px; width: 1px; height: 9px; }
  .x::after { top: 4px; width: 9px; height: 1px; }
  .tl { top: -5px; left: -5px; } .tr { top: -5px; right: -5px; }
  @media (min-width: 768px) { .dock { display: flex; } }
</style>

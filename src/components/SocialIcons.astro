---
import { siInstagram, siFacebook, siBehance } from 'simple-icons';
import { site } from '../i18n/ui';

// simple-icons no longer ships LinkedIn, so it is drawn by hand.
const linkedin =
  'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z';

const paths: Record<string, string> = {
  instagram: siInstagram.path,
  facebook: siFacebook.path,
  behance: siBehance.path,
  linkedin,
};

interface Props { size?: number; }
const { size = 18 } = Astro.props;
---
<ul class="social">
  {site.social.map((s) => (
    <li>
      <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
        <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d={paths[s.id]} fill="currentColor" /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { display: flex; gap: 0; }
  .social li + li a { border-left: 0; }
  a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--ink);
    transition: background 0.2s, color 0.2s;
  }
  a:hover { background: var(--blue); border-color: var(--blue); color: var(--paper); }
</style>

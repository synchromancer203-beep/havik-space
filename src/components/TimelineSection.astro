---
// One section of the /about timeline (work, education, …): numbered title and its entries.
// An entry with shots gets a thumbnail beside it that opens them in a viewer.
import { Image, getImage } from 'astro:assets';
import type { Section } from '../data/about';
import type { Lang } from '../i18n/ui';

interface Props { s: Section & { n: number }; lang: Lang; }
const { s, lang } = Astro.props;
const vi = lang === 'vi';
const full = async (shots: ImageMetadata[]) =>
  (await Promise.all(shots.map((x) => getImage({ src: x, width: 1600, format: 'webp' })))).map((x) => x.src).join(' ');
const entries = await Promise.all(s.entries.map(async (e) => ({ ...e, full: e.shots ? await full(e.shots) : '' })));
---
<div class="tl-sec">
  <h2 class="display tl-title" data-enter="rise"><span class="num">{s.n}.</span><span class="line"><span>{s.title[lang]}</span></span></h2>
  <ol class="tl-list">
    {entries.map((e) => (
      <li data-enter class:list={{ 'has-shots': e.shots }}>
        <span class="tl-when meta">{e.when}</span>
        <span class="tl-what">{e.what[lang]}</span>
        {e.where && <span class="tl-where">{e.where[lang]}</span>}
        {e.shots && (
          <button type="button" class="tl-shot" data-full={e.full} data-title={e.what[lang]} aria-label={`${vi ? 'Xem' : 'View'}: ${e.what[lang]}`}>
            <Image src={e.shots[0]} alt="" widths={[160, 320]} sizes="96px" />
            {e.shots.length > 1 && <span class="tl-count meta">{e.shots.length}</span>}
          </button>
        )}
      </li>
    ))}
  </ol>
</div>
{entries.some((e) => e.shots) && (
  <dialog class="tl-lb" aria-label={vi ? 'Xem ảnh' : 'Viewer'}>
    <img class="tl-lb-img" alt="" />
    <button type="button" class="tl-lb-btn tl-lb-prev" aria-label={vi ? 'Ảnh trước' : 'Previous'}>←</button>
    <button type="button" class="tl-lb-btn tl-lb-next" aria-label={vi ? 'Ảnh sau' : 'Next'}>→</button>
    <button type="button" class="tl-lb-btn tl-lb-close" aria-label={vi ? 'Đóng' : 'Close'}>✕</button>
  </dialog>
)}

<style>
  /* Doubled class: outranks the page's own .tl-list li columns. */
  .tl-list li.has-shots.has-shots { grid-template-columns: 1fr auto; column-gap: 16px; }
  .has-shots > :not(.tl-shot) { grid-column: 1; }
  .tl-shot {
    grid-column: 2; grid-row: 1 / span 3; align-self: center; position: relative;
    width: 96px; padding: 0; border: 0; background: none; cursor: zoom-in;
    box-shadow: 0 16px 30px -18px rgba(32, 32, 48, 0.55); transition: transform 0.3s var(--ease-out);
  }
  .tl-shot:hover { transform: translateY(-2px) rotate(-1deg); }
  .tl-shot :global(img) { display: block; width: 100%; height: auto; }
  .tl-count { position: absolute; right: 4px; bottom: 4px; background: var(--ink); color: var(--paper); padding: 1px 6px; font-size: 10px; }

  .tl-lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(20, 20, 30, 0.92); }
  .tl-lb[open] { display: grid; place-items: center; }
  .tl-lb::backdrop { background: transparent; }
  .tl-lb-img { max-width: calc(100vw - 160px); max-height: calc(100dvh - 96px); width: auto; height: auto; box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6); }
  .tl-lb-btn { position: absolute; width: 48px; height: 48px; border: 1px solid rgba(255, 255, 255, 0.4); background: none; color: #fff; font-size: 18px; cursor: pointer; }
  .tl-lb-btn:hover { background: #fff; color: var(--ink); }
  .tl-lb-prev { left: var(--gutter); top: 50%; translate: 0 -50%; }
  .tl-lb-next { right: var(--gutter); top: 50%; translate: 0 -50%; }
  .tl-lb-close { right: var(--gutter); top: 16px; }
  .tl-lb.single .tl-lb-prev, .tl-lb.single .tl-lb-next { display: none; }

  @media (min-width: 1024px) {
    :global(.tl-two) .tl-list li.has-shots.has-shots, :global(.tl-photos) .tl-list li.has-shots.has-shots { grid-template-columns: 8em 1fr auto; column-gap: 24px; }
    .has-shots > .tl-what, .has-shots > .tl-where { grid-column: 2; }
    .tl-shot { grid-column: 3; }
  }
  @media (max-width: 767px) {
    .tl-shot { width: 72px; }
    .tl-lb-img { max-width: calc(100vw - 24px); max-height: calc(100dvh - 140px); }
    .tl-lb-prev, .tl-lb-next { top: auto; bottom: 16px; translate: none; }
    .tl-lb-prev { left: auto; right: calc(var(--gutter) + 56px); }
  }
</style>

<script>
  const lb = document.querySelector<HTMLDialogElement>('.tl-lb');
  if (lb) {
    const img = lb.querySelector<HTMLImageElement>('.tl-lb-img')!;
    let set: string[] = [];
    let at = 0;
    const view = (i: number) => { at = (i + set.length) % set.length; img.src = set[at]; };
    document.querySelectorAll<HTMLButtonElement>('.tl-shot').forEach((b) => b.addEventListener('click', () => {
      set = b.dataset.full!.split(' ');
      img.alt = b.dataset.title!;
      lb.classList.toggle('single', set.length < 2);
      view(0);
      lb.showModal();
    }));
    lb.querySelector('.tl-lb-prev')!.addEventListener('click', () => view(at - 1));
    lb.querySelector('.tl-lb-next')!.addEventListener('click', () => view(at + 1));
    lb.querySelector('.tl-lb-close')!.addEventListener('click', () => lb.close());
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); view(at - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); view(at + 1); }
    });
  }
</script>

---
import SocialIcons from './SocialIcons.astro';
import { getLang, useT, href, nav } from '../i18n/utils';
import { site } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = useT(lang);
const year = new Date().getFullYear();
---
<footer class="footer" id="contact">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a href={`mailto:${site.email}`} class="mail">{site.email}<span aria-hidden="true">&nbsp;↗</span></a>
        <SocialIcons />
      </div>

      <nav aria-label={t('footer.nav')}>
        <p class="meta">{t('footer.nav')}</p>
        <ul>
          {nav.filter((n) => n.path !== '#contact').map((n) => <li><a href={href(lang, n.path)}>{t(n.key)}</a></li>)}
        </ul>
      </nav>
    </div>

    <p class="wordmark display" aria-hidden="true">HAVIK<span>.</span></p>

    <div class="bottom meta">
      <span>© {year} Havik</span>
      <a href={href(lang, '/privacy')}>{t('footer.privacy')}</a>
    </div>
  </div>
  <div class="strip" aria-hidden="true"></div>
</footer>

<style>
  .footer {
    position: relative; z-index: 1; margin-top: auto;
    background:
      radial-gradient(50% 60% at 100% 0%, rgba(71, 55, 255, 0.04), transparent 70%),
      linear-gradient(180deg, #ffffff 0%, #f1f1f4 100%);
    border-top: 1px solid var(--line);
  }
  .top { display: grid; gap: 40px; padding-block: 72px 32px; }
  .brand { display: grid; gap: 24px; justify-items: start; }
  .mail {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(28px, 4vw, 56px); line-height: 1; overflow-wrap: anywhere;
    border-bottom: 1px solid var(--blue);
    padding-bottom: 6px;
  }
  .mail:hover { color: var(--blue); }
  nav ul { display: grid; gap: 6px; margin-top: 12px; }
  nav a { text-transform: uppercase; font-size: 13px; letter-spacing: 0.08em; }
  nav a:hover { color: var(--blue); }

  .wordmark {
    font-size: clamp(96px, 22vw, 360px);
    font-weight: 800;
    line-height: 0.78;
    margin-inline: -0.03em;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .wordmark span { color: var(--blue); }

  .bottom { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding-block: 20px 28px; }
  .bottom a:hover { color: var(--ink); }
  .strip { height: 6px; background: var(--blue); }

  @media (min-width: 768px) {
    .top { grid-template-columns: 2fr 1fr; }
    .bottom { padding-bottom: 88px; }
  }
</style>

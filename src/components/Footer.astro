---
import SocialIcons from './SocialIcons.astro';
import Frame from './Frame.astro';
import { getLang, useT, href, nav } from '../i18n/utils';
import { site } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = useT(lang);
const year = new Date().getFullYear();
---
<Frame as="footer" class="footer" inner="footer-in" id="contact" data-no-transition="">
  <div class="container footer-box">
    <div class="top">
      <div class="brand">
        <a href={`mailto:${site.email}`} class="mail">{site.email}<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" /></svg></a>
        <SocialIcons />
      </div>

      <nav aria-label={t('footer.nav')}>
        <ul>
          {nav.filter((n) => n.path !== '#contact').map((n) => <li><a href={href(lang, n.path)}>{t(n.key)}</a></li>)}
        </ul>
      </nav>
    </div>

    <p class="wordmark display" aria-hidden="true">HAVIK<span>.</span></p>

    <div class="bottom meta">
      <span>© {year} Havik</span>
      <a href={href(lang, '/privacy')}>{t('footer.privacy')}</a>
    </div>
  </div>
  <div class="strip" aria-hidden="true"></div>
</Frame>

<style>
  /* The last frame of every page: contact on top, the wordmark filling the rest. */
  .footer {
    --frame-bg:
      radial-gradient(50% 60% at 100% 0%, rgba(71, 55, 255, 0.04), transparent 70%),
      linear-gradient(180deg, #ffffff 0%, #f1f1f4 100%);
  }
  .footer :global(.footer-in) { justify-content: space-between; }
  .footer-box { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .top { display: grid; gap: 40px; padding-block: clamp(32px, 8vh, 96px) 32px; }
  .brand { display: grid; gap: 24px; justify-items: start; }
  .mail {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(28px, 4vw, 56px); line-height: 1; overflow-wrap: anywhere;
    border-bottom: 1px solid var(--blue);
    padding-bottom: 6px;
  }
  .mail:hover { color: var(--blue); }
  /* Drawn, not the ↗ character: the display font lacks it and iOS swaps in the emoji. */
  .mail .arrow { display: inline-block; width: 0.62em; height: 0.62em; margin-left: 0.22em; vertical-align: 0.04em; }
  nav ul { display: grid; gap: 6px; }
  nav a { text-transform: uppercase; font-size: 13px; letter-spacing: 0.08em; }
  nav a:hover { color: var(--blue); }

  .wordmark {
    font-size: clamp(96px, 22vw, 360px);
    font-weight: 800;
    line-height: 0.78;
    margin-inline: -0.03em;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .wordmark span { color: var(--blue); }

  .bottom { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding-block: 20px 28px; }
  .wordmark { font-size: clamp(96px, min(22vw, 40vh), 360px); }
  .bottom a:hover { color: var(--ink); }
  .strip { height: 6px; background: var(--blue); }

  @media (min-width: 768px) {
    .top { grid-template-columns: 2fr 1fr; }
    .bottom { padding-bottom: 40px; }
  }
</style>

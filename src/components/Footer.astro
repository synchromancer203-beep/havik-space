---
import SocialIcons from './SocialIcons.astro';
import { getLang, useT, href, nav } from '../i18n/utils';
import { site } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = useT(lang);
const year = new Date().getFullYear();
---
<footer class="footer" id="contact">
  <div class="container">
    <div class="top">
      <div class="brand">
        <p class="meta">[ /05 {t('nav.contact')} ]</p>
        <a href={`mailto:${site.email}`} class="mail">{site.email}<span aria-hidden="true">&nbsp;↗</span></a>
        <SocialIcons />
      </div>

      <nav aria-label={t('footer.nav')}>
        <p class="meta">{t('footer.nav')}</p>
        <ul>
          {nav.filter((n) => n.path !== '/#contact').map((n) => <li><a href={href(lang, n.path)}>{t(n.key)}</a></li>)}
        </ul>
      </nav>
    </div>

    <p class="wordmark display" aria-hidden="true">HAVIK<span>.</span></p>

    <div class="bottom meta">
      <span>© {year} Havik</span>
      <span>21.0285°N 105.8542°E · Hà Nội</span>
      <a href={href(lang, '/privacy')}>{t('footer.privacy')}</a>
    </div>
  </div>
  <div class="strip" aria-hidden="true"></div>
</footer>

<style>
  .footer { background: var(--paper); border-top: 1px solid var(--ink); margin-top: auto; }
  .top { display: grid; gap: 40px; padding-block: 48px 32px; }
  .brand { display: grid; gap: 20px; justify-items: start; }
  .mail {
    font-family: var(--display); font-weight: 800; letter-spacing: -0.02em;
    font-size: clamp(20px, 4vw, 40px); line-height: 1.1; overflow-wrap: anywhere;
    border-bottom: 2px solid var(--blue);
  }
  .mail:hover { color: var(--blue); }
  nav ul { display: grid; gap: 6px; margin-top: 12px; }
  nav a { text-transform: uppercase; font-size: 13px; letter-spacing: 0.06em; }
  nav a:hover { color: var(--blue); }

  .wordmark {
    font-size: clamp(80px, 24vw, 360px);
    line-height: 0.78;
    margin-inline: -0.04em;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
    overflow: hidden;
  }
  .wordmark span { color: var(--blue); }

  .bottom { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding-block: 20px 28px; }
  .bottom a:hover { color: var(--ink); }
  .strip { height: 8px; background: var(--blue); }

  @media (min-width: 768px) {
    .top { grid-template-columns: 2fr 1fr; }
    .bottom { padding-bottom: 88px; } /* room for the dock */
  }
</style>
